{
  "name": "agenttodo-server",
  "version": "1.0.0",
  "private": true,
  "description": "Agent-ToDo 后端服务 —— NestJS 10 + Prisma 5 + MySQL 8",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "seed": "node dist/prisma/seed.js",
    "seed:accounts": "node dist/prisma/seed.js accounts",
    "seed:all": "npm run build && npm run prisma:migrate:deploy && npm run seed",
    "backfill:activity": "node dist/prisma/backfill-activity.js"
  },
  "prisma": {
    "seed": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "file-type": "^16.5.4",
    "multer": "^2.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tencentcloud-sdk-nodejs-asr": "^4.1.315"
  },
  "devDependencies": {
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3"
  }
}
