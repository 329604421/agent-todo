# ============================================================================
# Agent-ToDo 后端 · 环境变量模板
# ----------------------------------------------------------------------------
# 用法：
#   cp .env.example .env
#   chmod 600 .env            # 里面有密钥，别让同实例的其他用户读到
#   ${EDITOR} .env            # 把所有 <...> 占位替换掉
#
# 三条纪律：
#   ① `.env` 绝不进仓库（.gitignore 已挡），也不要写进 ecosystem.config.js，
#      否则 `pm2 save` 会把密钥定格进 dump.pm2。
#   ② 小程序包体可解包 ⇒ 所有密钥只存服务端。
#   ③ 云厂商凭证用子账号 + 最小权限策略，不要用主账号密钥。
# ============================================================================

# ---------------------------------------------------------------- 进程
# 生产固定 production：它会同时关掉 ① 错误堆栈回显 ② DEV_OPENID 调试通道
NODE_ENV=production

# 只监听回环 —— 对外一律走 nginx（数据库端口与 3000 都不要对外开）
HOST=127.0.0.1
PORT=3000

# 健康检查 / 排障时返回给前端的版本号（GET /api/v1/health）
APP_VERSION=1.0.0

# ---------------------------------------------------------------- 数据库
# 时区必须写进连接串：timezone 用 '+08:00' 形式，不要写 'Asia/Shanghai'（驱动只认偏移）。
# 密码里若有 @ : / ? # 等字符必须 URL 编码，否则连接串解析错、报「找不到主机」。
DATABASE_URL="mysql://agenttodo:<DB_PASSWORD>@127.0.0.1:3306/agenttodo?timezone=%2B08%3A00&connection_limit=5"

# ---------------------------------------------------------------- 微信
# 小程序的 AppID / AppSecret。AppID 可公开，AppSecret 绝不可进客户端。
WX_APPID=<小程序 AppID>
WX_SECRET=<小程序 AppSecret>

# code2session 的 HTTP 超时。微信侧偶发慢响应，超时太短会误报 1001 让用户重登
WX_HTTP_TIMEOUT_MS=8000

# ---------------------------------------------------------------- 鉴权
# 生成方式（不要手打）：openssl rand -hex 32
# 换掉它 = 所有人被登出（JWT 验签失败），平时不要动
JWT_SECRET=<openssl rand -hex 32 的结果>
# 7 天。本项目不做 refresh token：用户量小，到期重登的成本低于维护刷新链路
JWT_EXPIRES_IN=7d

# 模型厂家 API key 的加密密钥（AES-256-GCM 密钥派生用）—— 见 src/common/secrets.ts
# 生成：openssl rand -hex 32
# 换掉它 = 既有密文全部解不开（表现成「查询失败：密钥不可用」），
# 真要换必须连同数据一起重加密，不能只改这一行。
TOKEN_KEY_ENC_SECRET=

# ---------------------------------------------------------------- 图片
# 必须与 nginx 的 alias 逐字一致（nginx/agenttodo.conf 里那行 alias 就指这里）
UPLOAD_DIR=/data/uploads
# 对外前缀。换域名 / 上 CDN 时只改这一行 —— 库里存的一直是相对路径，可逆。
FILE_BASE_URL=https://todo.example.com
# 单张图片上限（字节）。改大它必须同时改 nginx 的 client_max_body_size（模板里是 4m）
UPLOAD_MAX_BYTES=1048576

# ---------------------------------------------------------------- 管理接口
# 保护 /admin/*（待批列表、白名单增删）。生成方式：openssl rand -hex 24
# 留空 ⇒ 管理接口整体返 404（当作不存在）
ADMIN_TOKEN=<openssl rand -hex 24 的结果>
# 自己的 openid。seed 时会顺带加进白名单，省得第一次登录被 1002 拦住
ADMIN_OPENID=<你的 openid>

# ---------------------------------------------------------------- 白名单开关
# true = 跳过白名单，任何人登录都自动建号（临时开放注册用）。
# 打开后，拿到小程序码的人都能进来占用数据库，只适合临时开放期。
# 只认布尔字面量 true；1 / yes / on / 留空 一律不算开着。
# 数据仍是各人各一份：Project / Todo / Mindmap / Capsule 全部带 userId 外键。
ALLOW_ANY_USER=false

# ---------------------------------------------------------------- 语音识别
# 用子账号密钥，只授 asr:SentenceRecognition 一个动作
TENCENT_SECRET_ID=<子账号 SecretId>
TENCENT_SECRET_KEY=<子账号 SecretKey>
# 一句话识别的地域，就近选即可
ASR_REGION=ap-shanghai
# 16k_zh = 中文通用 16k 采样。必须与小程序录音参数（mp3 / 16k / 单声道）配套，
# 引擎选错不报错，只会返回乱码或空串（症状很像「识别不准」）。
ASR_ENGINE=16k_zh
# 单次请求超时（毫秒）
ASR_TIMEOUT_MS=10000
# 每人每天调用上限。云厂商的频率限制是账号级的，
# 不按人限流的话一个人刷脚本就能把整月免费额度打光。
ASR_DAILY_LIMIT=50

# ---------------------------------------------------------------- 调试通道
# 仅 NODE_ENV != production 时生效（auth.service.ts 有硬判断）。
# 本机联调、Postman 手测时用它直接换 token。生产环境请留空。
DEV_OPENID=

# ---------------------------------------------------------------- 种子数据（只在本机跑）
# `npm run seed` 灌演示数据时用的账号，与真人 openid 分开
SEED_OPENID=seed-demo-openid
SEED_NICKNAME=演示工位

# ---------------------------------------------------------------- 提示词增强 / 语义转脑图
# 火山方舟 API Key（方舟控制台 → API Key 管理）。
# 留空时 POST /ai/enhance 会直接报「增强服务未配置」，不会静默降级返回原文。
# 这是服务端 key，只活在服务器 .env 里，绝不进小程序、绝不进 git。
ARK_API_KEY=
# 模型 ID（完整版本号）。换模型 / 换版本只改这一行，不用重新发小程序版本。
ARK_MODEL=deepseek-v4-1-flash-261017
# 方舟 API 基址，一般不用改
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
