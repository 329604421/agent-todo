@import "./mm-canvas.wxss";
/* ==========================================================================
   模块组件（09-21 起）—— 只渲染 <main>，骨架与外框归壳页 pages/shell。
   样式隔离设为 apply-shared，app.wxss 的设计令牌与骨架类对组件同样生效；
   选择器里保留 .mod-port 的写法，因为 .app 就在壳页的祖先链上。
   ========================================================================== */

/* 组件宿主：占满壳页的挂载位 .modwrap */
:host {
  flex: 1 1 0;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* 品牌栏（★ 09-22 走查：只竖屏、且挂在壳页）样式在 app.wxss */

/* 项目胶囊里的「已归档」角标 */
/* ★ 118 轮：底 / 字走令牌 —— `#FFF4C4` ＝ `--h1`、`#8A5A00` ＝ `--u-mid-t`，逐值相同 ⇒ 零视觉变化。 */
.pill-arc {
  font-size: 11px;
  color: var(--u-mid-t);
  background: var(--h1);
  border-radius: 999px;
  padding: 1px 6px;
  margin-left: 2px;
}

/* 空态：本模块还没打开过脑图（抽屉会自动弹出，这里也留一个入口）
   ★ 本轮：原来这一套 `.mm-empty`（实线框 / 17/600 / `--slate` / `.btn-dark`）已**整段并入**
     app.wxss 的三处共用骨架 `.blank` —— 同一条判据：同一台设备翻三页不该像两个产品。
     ⚠️ 它原带的 `min-height: 0` 没有丢：已写在全局 `.blank` 上（这页的空态在 flex 列里）。 */

/* ---------------- 主工作区 ----------------
   顺序（★ 本轮起）：① 区块头「脑图画布」＋右侧信息行 → ② 画布容器（含顶部工具栏 ＋ 底部节点浮条）
   横屏 776 − 上 0 − 下 20 ＝ 756 ＝ 区块头 **34** ＋ 画布 **722**
   ★ 本轮（脑图专项 7 条）：**卡下方那行脑图级操作行整条取消** ⇒ 让出 40 的行 ＋ 12 的 .mm-area gap，
     670 → **722**（竖 1006 → 1058）。工作区里现在只有「区块头 ＋ 画布卡」两件，
     所以 .mm-area 的 gap 实际上不再被用到 —— 留着不碍事（cards 之间若将来再插一块仍按 12 走）。
   （演变：第四轮把节点操作行搬进容器 ⇒ 画布 600 → 652；09-22 走查·上补区块头，652 → 618；
     09-22 走查·下首块间距 16 → 20 ⇒ padding-top 8 → 12，618 → 614；
     09-22 走查·尾横屏标题栏整条去掉 ⇒ 740 → 776、上 12 → 20，614 → 642；
     09-22 走查·六横屏顶部收敛到统一口径 20 → 12 ⇒ 642 → 650；
     09-22 走查·十一横屏首块之前 padding 12 → 0 ⇒ 650 → 662；
     09-22 走查·十二横屏首个区块头再吃掉自带 8 ⇒ 662 → 670）
   ⚠️ 横屏 padding 不在这里写 —— 交给 app.wxss 的 .workarea 一处统一给出
      （竖屏才由下面 .mod-port .mm-area 覆盖）。 */
.mm-area {
  gap: 12px;
}

/* ---------------- 子标题右侧 · 脑图信息行（★ 本轮第 1 条；★ 第 81 轮改版式） ----------------
   原来这三样（项目胶囊 / 切换脑图 / 导出）分散在卡下方那行脑图级操作行里，
   那行已整条删除 ⇒ 项目与「这张图叫什么 / 多久没动」并到子标题这一行。

   ★ 第 81 轮两处改动：
     · 第 6 条 —— 整段**靠左**：`.mh` 跟在「脑图画布」后面（wxml 里 `.sec-flex` 挪到
       它之后），两者之间加一道 `.mh-div`（**与子标题的分隔**）。
       原来靠右时，标题与它之间隔了整整一行空白，读起来像两个不相干的元素。
     · 第 5 条 —— 名称 / 项目 / 时间三样的**字号与颜色统一**：都用「所属项目」那一套
       （13px + `--slate`）。原来是 14px 主墨 / 13px 次墨 / 13px 微墨三档并排，显得脏。
       ⚠️ 名称的 `font-weight: 600` **留着** —— 一整行同色同号时，它是唯一还能指认
          "哪个是这张图的名字"的东西（用户点的是"颜色和字号"，没点字重）。 */
.mh {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
}

/* 「脑图画布」与这段信息之间的分隔（★ 第 81 轮第 6 条）——
   ⚠️ 与行内那两道 `.mh-sep` 分开两个类名：这道是**段落级**的分隔（更高 14px），
      行内那两道是**信息块之间**的分隔（12px）。同高同色会让"标题｜信息"的层级糊掉。 */
.mh-div {
  width: 1px;
  height: 14px;
  background: var(--hairline);
  flex: 0 0 auto;
}

.mh-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--slate);
  max-width: 260px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mh-sep {
  width: 1px;
  height: 12px;
  background: var(--hairline);
  flex: 0 0 1px;
}

.mh-pj {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 5px;
  flex: 0 1 auto;
  min-width: 0;
}
/* 未归属项目时整颗不可点、轻微收色 —— 点了也没地方去 */
.mh-pj.off { pointer-events: none; }
/* ★ 审查-02 S1（2026-10-15）：按下反馈 —— 与「我的」页 `.ag-chip-hv` 同族（改底 `--chip`）。
   ⚠️ `.mh-pj` 本身**没有底色也没有 padding**（纯文字胶囊，色点＋名字＋「已归档」三件紧挨着）
      ⇒ 按下给一块圆角灰底即可。**不要**为了"给色块留呼吸"去加 `padding` 或负 `margin`：
         那会在按下的那一帧改变它占的宽度，把相邻的 `.mh-sep` / `.mh-time` 推来推去（布局抖动）。
      圆角不参与布局 ⇒ 安全。 */
.mh-pj-hv { background: var(--chip, #F1F2F5); border-radius: 6px; }

.mh-dot {
  width: 8px;
  height: 8px;
  border-radius: 999px;
  flex: 0 0 8px;
}

/* 所属项目 = 这一行的**基准样式**（名称与时间都照它统一，★ 第 81 轮第 5 条） */
.mh-pj-t {
  font-size: 13px;
  font-weight: 500;
  color: var(--slate);
  max-width: 160px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mh-arch {
  font-size: 10px;
  padding: 0 5px;
  border-radius: 999px;
  background: var(--u-hold-bg, #F3F4F6);
  color: var(--stone, #8E91A0);
  flex: 0 0 auto;
}

/* ★ 第 81 轮第 5 条：原来是 13px + `--muted`（微文字），与上面两样并排时是三档色号中的
   最浅一档；用户要求"统一使用当前项目名称的文字颜色和字号"⇒ 改跟 `.mh-pj-t` 同一套。 */
.mh-time {
  font-size: 13px;
  font-weight: 500;
  color: var(--slate);
  white-space: nowrap;
  flex: 0 0 auto;
}

/* ---------------- 区块 · 脑图画布 ----------------
   区块头（.sec-head）＝ 卡外上一行的「脑图画布」标题，样式与其余四页同源（app.wxss）；
   这一层 .sec 吃满工作区余高，卡片本体再在它里面 flex:1 铺满。 */
.mm-sec { flex: 1; min-height: 0; }
.mm-sec .mm-card { flex: 1; min-height: 0; }

/* ---------------- 卡 · 脑图画布 ---------------- */
.mm-card {
  flex: 1;
  min-height: 0;
  position: relative;
  background: var(--card);
  border: 1px solid var(--hairline);
  border-radius: 14px;
  overflow: hidden;
  /* PC：能拖的画布给个抓手光标（移动端会忽略 cursor，写在这里不碍事） */
  cursor: grab;
}

/* ---------------- 画布变换层（★ 第五轮） ----------------
   节点层与连线层都住在 .mm-viewport 里，transform 由 JS 写在行内
   （translate + scale，原点锁左上角）⇒ 平移缩放时两层永远同步，不会错位。 */
.mm-viewport {
  position: absolute;
  left: 0;
  top: 0;
  width: 1168px;
  /* ★ 185 轮：横屏画布高**不再写死 722** —— 与 `CANVAS.land.h` 同源
     （＝ 横屏工作区 − 54，见 utils/mindmap-core.js 的 syncLandCanvasH）。
     ⚠️ `.mm-viewport` 的宽高就是**渲染出来的画布**：mod-mindmap.js 的 measure()
         拿它的 boundingClientRect 反推卡片缩放 ⇒ 这里与 JS 的 CANVAS.land 必须
         逐值一致，否则"屏幕坐标 → 画布坐标"整体偏一个比例。 */
  height: calc(var(--work-h-land) - 54px);
  transform-origin: 0 0;
}

/* 拖拽标记 · **候选父节点**高亮（★ 第 66 轮新增；第 68 轮换口径；**第 69 轮改回品牌黄**）——
   ⚠️ 这条规则换过三次口径，别再往回改：
     · 最初：圈"目标节点的整棵子树"（黄虚线 ＋ 淡黄底）—— 参考图里根本没有这层；
     · 第 66 轮：改成给目标节点自己套一圈**实线**描边（品牌黄），
       但"目标"由**手指位置**决定；
     · 第 68 轮：颜色改蓝 `#2E6BE6`，"目标"改由**浮动节点的左上角**决定；
     · 第 69 轮（当前）：**颜色按用户口径改回品牌黄** ——
       用户原话"整个交互变色用的是蓝色，应该用应用的品牌色黄色"。
       标记色从品牌色走：本工程只有一个强调色（`--yellow` / `#FFD02F`）。
   框内不填色（节点自己的底色照常透出来），所以只描边。 */
.mm-parent-box {
  position: absolute;
  box-sizing: border-box;
  border-radius: 8px;
  border: 2px solid var(--yellow);
  background: transparent;
  /* ★ 第 212 轮：从 8 抬到 24 —— 必须**高过 `.mm-ghost`（21）**。
     旧位置在 `.mm-viewport` 里面，而 viewport 带 transform、自成一个层叠上下文，
     里面的 z-index 再大也压不过外面的拖动体 ⇒ 被拖节点比目标大时，黄框整个被盖住，
     用户看到的就是"明明盖住了却看不出变色"。搬出 viewport 之后这条才真正生效。
     ⚠️ 边框**不跟 `sv` 缩**（JS 只缩 left/top/w/h）：缩小视图下高亮会显得粗一点，
        但"看得见"优先于"等比"。 */
  z-index: 24;
  pointer-events: none;
}

/* 候选父节点是**根**时：根自带品牌黄实心底，黄框压上去等于没画 ⇒
   改走「白间隙 ＋ 黄外环」双环（66 轮的老办法；68 轮改蓝时撤掉过，69 轮改回黄必须补回来）。
   第一层 2px 纯白 shadow 当间隙、第二层 2px 品牌黄当外环。 */
.mm-parent-box.is-root {
  border-color: transparent;
  box-shadow: 0 0 0 2px var(--card), 0 0 0 4px var(--yellow);
}

/* 拖拽标记 · **候选父节点被拖动体盖住**时（★ 第 212 轮 · `.is-under`，由 JS 现算交叠≥25%）——
   为什么需要这一层：框抬到拖动体之上以后仍然只画 2px 边，而拖动体把候选父节点整个罩住时，
   那个框看起来像"圈住了拖动体自己的一段字"，分不清它框的是下面那颗节点。
   补一层 16% 黄底之后，那一块读作"被挖出来高亮了"。
   ⚠️ **只在被盖住时**才有这个类：正常情形下框露在外面，第 68 轮那条
      "框内不填色、节点底色照常透出来"的设计原样保留 —— 别把它挪到 `.mm-parent-box` 本体上，
      那会让每次拖拽都多出一块色，画面反而更花。
   ⚠️ 放在 `.is-root` 之后（同特异性靠先后）：根被盖住时也要有这层底。
   ⚠️ 必须放在 `.is-cancel` **之前** —— 取消态要把它盖掉（取消态是灰虚线，不该带黄）。 */
.mm-parent-box.is-under {
  background: rgba(255, 208, 47, 0.16);
}

/* 拖拽标记 · **取消态**（★ 第 211 轮 · P0-2）——
   拖到没有任何落点的地方松手 ⇒ **父与位次都不动**。框**照样亮着**
   （参考图口径：任何时刻都有且只有一个父节点亮着框，不能出现"什么都不亮"的空档），
   但换成灰虚线、去掉一切黄 —— "亮着"＝这里是你现在的家，"灰虚线"＝这次不会挂回去。
   ⚠️ 放在 `.is-root` **之后**：两者特异性同为 (0,2,0)，靠先后定输赢；
      根节点作为当前父、又拖到空白时，取消态必须压过双环。
   ⚠️ 不要去改 `.mm-parent-box` 本体 —— 那是"确定的父"，永远是品牌黄实线。 */
.mm-parent-box.is-cancel {
  border-style: dashed;
  border-color: var(--muted);
  box-shadow: none;
  /* ★ 第 212 轮：兜一道 —— 取消态是"灰虚线、不生效"，绝不能带黄底。
     JS 的取消分支本来就不给 `under`，这里是防"哪天两个类被同时挂上"。 */
  background: transparent;
}

/* 拖拽标记 · **落位标记**（★ 第 211 轮 · P0-3）—— 候选父节点的孩子序列里"松手后插到第几位"。
   一枚黄底深字的序号圆点，落在那一格的**正中间**（JS 只给 left/top，负 margin 把圆心对上去）。
   ⚠️ 它**不是**第 68 轮删掉的同级竖线（那条说"手指现在压在哪两人之间"，是过程提示）——
      这枚说"松手后**确定**排第 k 位"，是结果提示。**不要**把线搬回来。
   ⚠️ 尺寸恒定、不吃画布缩放（与 `.mm-anchor-dot` 同一个理由）；
      缩到 20% 时它仍是 14px —— 那正是它存在的意义（低倍率下也能读出位次）。
      取 14 而不是 16：兄弟之间的缝通常只有 12px，16px 的圆点会明显压到两颗节点上。
   ⚠️ 黄底只能配**固定的深字** `#18191B`：`--primary` 在深色主题下会翻成近白，
      白字压在 #FFD02F 上对比 1.6 等于看不见；而这块底恒亮黄 ⇒ 上面的字必须**恒深**
      （与 `DRAG_C` 同一个理由：它属于"恒定亮面"，不跟主题翻）。 */
.mm-slot-mark {
  position: absolute;
  width: 14px;
  height: 14px;
  margin: -7px 0 0 -7px;
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--yellow);
  color: #18191B;
  font-size: 9.5px;
  font-weight: 700;
  line-height: 14px;
  text-align: center;
  box-shadow: 0 0 0 2px var(--card);
  /* ★ 第 212 轮：20 → 23。它排在拖动体（21）**之后**的 DOM 里，本该天然在上，
     但 `.mm-ghost` 自己给了 z-index 21 ⇒ 不给它一个更大的值就会被拖动体压住。
     层级顺序定为：ghost 21 ＜ 落位标记 23 ＜ 父节点框 24 ＜ 判定点 25。 */
  z-index: 23;
  pointer-events: none;
}

/* ⚠️ 第 68 轮删除：`.mm-drop-line`（同级插入指示线，横屏一条横线、竖屏一条**竖线**）。
   用户明确要求"去掉原来那个竖线来进行标记的模式" ——
   同级重排现在由「父节点框不变 ＋ 落点 index 变了」表达，不需要第二条线。 */

/* 拖拽标记 · 原位的**灰色虚线框**（★ 第 66 轮新增；第 68 轮改口径）——
   只圈**被拖节点自己**原来占的那一格。第 68 轮之前它圈的是整棵子树的占地范围，
   与下面那枚虚线大框重复表达了同一件事，现在两枚框各司其职：
     灰虚线 ＝ "它原来在这儿"    ／    标记黄虚线 ＝ "这一窝都会跟着走"
   ⚠️ 灰是**唯一不跟标记色走**的那枚框 —— 它表达"过去的位置"，
      而标记色表达"将被挂到哪儿"，两者语义不同、必须不同色（69 轮改黄时没动它）。
   ⚠️ **不做洗淡**：参考图里框内内容（子树、甚至被拖节点原来的文字）都是原样渲染的，
      看到的"淡字"其实是**拖动体自己的半透明白底**压在它上面透出来的
      （拖动体移开后就是正常黑色，见参考图 #5）。 */
.mm-src-box {
  position: absolute;
  box-sizing: border-box;
  border-radius: 10px;
  /* ★ 94 轮：裸写的 #C2C4CC 改走 `--hairline-strong`（#C7CAD5，通道差 ≤9 ⇒ 看不出）。
     它要"与标记黄不同色"这条仍然成立 —— `--hairline-strong` 是中性描边色，不会跟着标记色走。 */
  border: 2px dashed var(--hairline-strong, #C7CAD5);
  background: transparent;
  /* ⚠️ 必须高过节点层（.mm-node.sel 是 3），否则虚线框会被节点压在下面。 */
  z-index: 6;
  pointer-events: none;
}

/* 拖拽标记 · 子树范围的**虚线圆角大框**（★ 第 68 轮新增；69 轮改品牌黄）——
   包住被拖节点及其**整棵子树**（外扩量由 JS 的 SCOPE_PAD 给），
   表示"这一窝会一起搬走"。圆角比节点自己的大一档（16 vs 8），一眼分得出"这是范围框"。
   ⚠️ 它不表达落点 —— 落点永远只看 `.mm-parent-box` ＋ `.mm-links-hl`。 */
.mm-scope-box {
  position: absolute;
  box-sizing: border-box;
  border-radius: 16px;
  border: 2px dashed var(--yellow);
  background: transparent;
  z-index: 5;
  pointer-events: none;
}

/* ⚠️ 吸入高亮线（★ 第 66 轮新增）：与 .links 同一个画布尺寸 ＋ 同一套背景定位，
   但**压在节点层之上** —— 它是"将要挂到这儿"的唯一指认，被节点方块盖住就白画了。
   ★ 第 67 轮：left/top/width/height 改由**行内 style** 下发（＝这条线的渲染盒，见 renderBoxOf）
   —— 目标节点可能在画布外，固定尺寸会把这根线剪掉。这里留值只作兜底。 */
.mm-links-hl {
  position: absolute;
  left: 0;
  top: 0;
  width: 1168px;
  height: calc(var(--work-h-land) - 54px);
  background-repeat: no-repeat;
  background-position: 0 0;
  z-index: 4;
  pointer-events: none;
}

/* 拖动体 ＝ 节点本体（★ 第 66 轮，取代原来那枚小胶囊；第 68／69 轮换色）——
   它一直是"**半透明白底** ＋ 同色实线描边 ＋ 浮起阴影"：
   · 白底给到 0.86 不透明度 —— 压在源位置文字上时，下面的黑字会透成浅灰，
     这正是参考图 #3 里那层"幽灵字"的来源（不是另做了一层洗淡）；
   · 描边与「候选父节点框 / 预览线」**同色**（品牌黄），加上阴影，
     看起来就是"被拎起来了"。
   ⚠️ 三处颜色必须**永远同一个**（JS 的 `DRAG_C` ＝ 这里写死的 `#FFD02F`）：
      拖动体描边 · 父节点框 · 预览线。它们是同一条语义的三段表达，
      拆开上色就读成两套语言了。
   ⚠️ 品牌黄在**白底**上偏亮 ⇒ 靠 2px 宽度 ＋ 浮起阴影拉开层次
      （与 `.mm-node.sel` 的"白底＋黄实线框＋极淡黄外发光"同一个办法）。 */
.mm-ghost {
  z-index: 21;
  background: var(--frost-soft);
  /* 同 .mm-node.sel：框用 inset 阴影画，不从内容盒里吃宽度（见上面那段注释）
     ★ 审查-02 P1-14：第二层浮起投影走 `--sh-ghost`（深色下换黑纱；浅色逐值不变） */
  box-shadow: inset 0 0 0 2px var(--yellow), var(--sh-ghost);
  pointer-events: none;
}

/* 拖拽标记 · **判定点**（★ 2026-10-09 新增 · 211 轮改中心 · ★ 第 212 轮改左边缘）——
   用户口径：「把移动节点的判定位置做一个**高亮**，这样用户能知道系统使用哪个位置
   去寻找的父节点」。它就是 JS `anchorOf` 算出来的那个点。
   ★ 第 212 轮：**圆心落在被拖节点的左边缘垂直中点**上。
     · 半径只伸进节点 5.5px，而节点内边距是 11px ⇒ **一个字也不压**（这是用户说"不好看"的根）；
     · 一半在节点外 ⇒ 拖一个比目标还大的节点时，它仍然露在外面，指得清是谁；
     · 恒定左侧，不随父节点方向换边（旧口径朝父节点取边，同一棵树左右两半互为镜像）。
   拖动全程跟着节点走、位置不变；它一旦落进别的节点（或那一片孩子带），
   那个人就亮起 `.mm-parent-box` 黄框 —— 这两件合起来才读得懂"会挂到谁下面"。

   ★ 形态从「14px 透明环」改成「**11px 实心黄点 ＋ 墨描边 ＋ 白间隙**」：
     · 透明环是为了"不盖住字"临时找的折中，读起来仍是一个"圈"，比节点本身还抢眼；
       点的位置挪到边缘之后，压字的顾虑没了 ⇒ 回到最小、最像光标的形态。
     · 黄实心与拖拽语言同色（拖动体描边、父节点框都是品牌黄），一眼归进同一套；
     · 1.5px 主墨描边保证压在**品牌黄底**（根节点）上也有边；
     · `0 0 0 2px var(--card)` 是**白间隙**（深色下自动变卡片深色）——
       它常常正好压在节点描边或连线上，没有这圈间隙会糊成一坨。
   ⚠️ 尺寸恒定：位置由 JS 按 `sv` 换算，但**宽高不跟着缩放**（见 `dotStyleOf`）——
      它读作光标/指示器，缩到 0.5 时若跟着缩只剩 5px 就白做了。
   ⚠️ z-index 必须**高过 `.mm-ghost`（21）**与父节点框（24），否则会被压住一半。 */
.mm-anchor-dot {
  position: absolute;
  width: 11px;
  height: 11px;
  margin: -5.5px 0 0 -5.5px;
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--yellow);
  border: 1.5px solid var(--primary);
  box-shadow: 0 0 0 2px var(--card);
  z-index: 25;
  pointer-events: none;
}



/* ---------------- 节点 · PC 悬停态（★ 审查-02 P1-8） ----------------
   文件头第五轮起写着「PC 端：鼠标拖拽 / **悬停高亮** / 滚轮缩放」，但悬停那半句
   一直是**空承诺** —— `gsMove` 在未按下时第一站就 `return`，鼠标划过节点没有任何
   反馈，用户无从预判"点下去会选中谁、按住会拖谁"。现在补上（`hoverId` ＋ 下面这档）。
   ── 为什么是"外圈灰环"而不是"换底色" ──────────────────────────────
   · 节点底**按层级不同**（根是品牌黄实心，其余是卡底），而 `.mm-node.hv`(0,2,0)
     与层级规则同为 (0,2,0) ⇒ 换底色会把根节点的黄**一起换掉**（"鼠标一划过根就变色"
     是明显的错）。外圈不碰底色，**白底黄底都读得出来**。
   · 环形用 `box-shadow` 画在**外面** ⇒ 不占内容盒，节点宽高账目与 JS 算的一字不差
     （与 `.sel` 用 `inset` 是同一个理由的另一面）。
   ⚠️ 它**必须比 `.sel` 轻**：悬停只说明"鼠标在这儿"，不是"选中" ⇒ 一圈 2px 中性灰，
      不描黄边、不加黄外发光、不动 z-index。`.sel` 才是 3。
   ⚠️ 两者同时命中时应当由 `.sel` 赢 —— 特异性同为 (0,2,0)，靠**先后**定输赢；
      所以本类**排在 `.sel` 之前**，别挪到后面去。 */
.mm-node.hv {
  box-shadow: 0 0 0 2px var(--hairline-strong);
}

/* 当前选中节点：**白底 ＋ 品牌黄实线框**
   （参考版选中就是"把底提亮 ＋ 描一圈强调色" —— 底色从灰提到白是主信号，
     黄框是辅信号。品牌黄在白底上偏亮，所以再补一圈极淡的黄外发光，
     让"被选中"在低亮度屏上也读得出来。）

   ⚠️ 第 67 轮改成 `inset` 阴影画框、不再用 border：节点现在是"按字数折行、
      文字必须全部显示"，border 会从**内容盒**里吃掉 4px，正好把最后半个字挤出去。
      inset 阴影不占布局，宽高账目跟 JS 算的完全一致。 */
.mm-node.sel {
  background: var(--sel-bg);
  box-shadow: inset 0 0 0 2px var(--yellow), 0 0 0 3px rgba(255, 208, 47, 0.32);
  z-index: 3;
}

/* 根节点选中时底色本来就是黄的 ⇒ 框要换个表达：外面加两圈实体黄环，读作"被圈住了" */
.mm-node.lv0.sel {
  background: var(--yellow);
  box-shadow: 0 0 0 2px var(--yellow), 0 0 0 5px rgba(255, 208, 47, 0.34);
}

/* ---------------- 节点 · 编辑态（★★ 第 112 轮新建） ----------------
   用户口径（逐字）：「当选中节点后点击"编辑"按钮后，选中的节点在**原有边框变色的基础上
   增加闪烁效果**（可以参照语音输入模式，只不过**无需遮罩倒计时**）」。

   ★ "原有边框变色"就是上面那条 `.mm-node.sel`（白底 ＋ 黄实线框 ＋ 极淡黄外发光）——
     所以这里是**在它之上加一层动画**，不是另起一套配色：关键帧的 `0%/100%` 与
     `.sel` 那条**逐字同值**（这正是"基础态"），只有中段在动。
   ★ "参照语音输入模式"＝借用它那套**外扩光环**的手法（`.mm-node.rec` 的 `mm-breath`）；
     "闪烁"与"呼吸"的差别只在**节奏**：这里 0.9s（比呼吸的 1.35s 快一档）、
     且中段把**内圈本身也压淡**（`rgba(…, 0.22)`）—— 一眼看过去是"框在闪"，
     而不只是"外面有光在扩"。⚠️ 别把中段的内圈也写成实黄：那样只剩光圈在动，读作"呼吸"。
   ⚠️ 与 `.rec` 抢的是**同一个 `box-shadow`**，两条都写 `animation` 且特异性同为 (0,2,0)
      ⇒ 靠**先后**定输赢。这里排在 `.rec` **之前**：万一将来两个类同时挂上，
        应当让"正在录音"赢（录音有倒计时、更不可打断）。两者目前互斥
        （`runAct` 里 `act !== 'edit' && editId` 会先把编辑态提交掉）。
   ⚠️ 卡片上**不再有任何输入控件**（第 112 轮把编辑区搬去底部浮条）——
     这条规则里没有 `padding`、没有尺寸改动，**文字一行都不动**，只闪框。 */
@keyframes mm-flash {
  0%, 100% { box-shadow: inset 0 0 0 2px var(--yellow), 0 0 0 3px rgba(255, 208, 47, 0.32); }
  50%      { box-shadow: inset 0 0 0 2px rgba(255, 208, 47, 0.22), 0 0 0 10px rgba(255, 208, 47, 0); }
}

/* 根节点（黄底）沿用 `.lv0.sel` 那套"外环"表达 —— 塞 `inset` 进去在黄底上画不出线 */
@keyframes mm-flash-root {
  0%, 100% { box-shadow: 0 0 0 2px var(--yellow), 0 0 0 5px rgba(255, 208, 47, 0.34); }
  50%      { box-shadow: 0 0 0 2px rgba(255, 208, 47, 0.28), 0 0 0 13px rgba(255, 208, 47, 0); }
}

.mm-node.edit {
  animation: mm-flash 0.9s ease-in-out infinite;
  /* 与 `.rec` 同档：编辑中的那一格是此刻最该被看见的对象 */
  z-index: 4;
}
.mm-node.lv0.edit { animation-name: mm-flash-root; }

/* ---------------- 节点 · 录音态（★ 第 70 轮） ----------------
   用户口径："节点卡片使用呼吸式光圈来做提示正在录音，且节点卡片使用半透明遮罩盖住节点文字，
   遮罩上浮现 60 秒倒计时。"

   ⚠️ 呼吸光圈与选中框**抢的是同一个 `box-shadow`** —— 动画一旦跑起来，
      普通声明（`.mm-node.sel` 那条）会被完全盖住。所以这两个关键帧里必须
      **把选中框那条 `inset` 一起写进去**，否则录音一开始、"被选中"的框就消失了。
   ⚠️ 根节点（黄底）另走一套：它的框本来就是"外环"（`.lv0.sel`），
      塞 `inset` 进去反而在黄底上画一条看不见的黄线。 */
@keyframes mm-breath {
  0%   { box-shadow: inset 0 0 0 2px var(--yellow), 0 0 0 0 rgba(255, 208, 47, 0.62); }
  70%  { box-shadow: inset 0 0 0 2px var(--yellow), 0 0 0 12px rgba(255, 208, 47, 0); }
  100% { box-shadow: inset 0 0 0 2px var(--yellow), 0 0 0 0 rgba(255, 208, 47, 0); }
}

@keyframes mm-breath-root {
  0%   { box-shadow: 0 0 0 2px var(--yellow), 0 0 0 3px rgba(255, 208, 47, 0.62); }
  70%  { box-shadow: 0 0 0 2px var(--yellow), 0 0 0 14px rgba(255, 208, 47, 0); }
  100% { box-shadow: 0 0 0 2px var(--yellow), 0 0 0 3px rgba(255, 208, 47, 0); }
}

.mm-node.rec {
  animation: mm-breath 1.35s ease-out infinite;
  /* 高过普通选中节点（.sel 是 3）：录音时它是最该被看见的那一格 */
  z-index: 4;
}
.mm-node.lv0.rec { animation-name: mm-breath-root; }

/* 半透明遮罩 —— 盖住节点文字，倒计时浮在正中。
   ⚠️ 它是**节点卡片内部**的一层（不是独立浮层），所以跟着画布缩放一起缩；
      字号也就跟着缩，与节点文字始终成比例 —— 这正是想要的。 */
.mm-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 8px;
  background: var(--frost-faint);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  pointer-events: none;
}

.mm-mask-t {
  font-size: 15px;
  line-height: 20px;
  font-weight: 600;
  color: var(--primary);
  /* 数字等宽 —— 否则 59 → 58 时那一行会左右晃一下 */
  font-variant-numeric: tabular-nums;
  /* ★ 第 89 轮：这里现在有两种文案 —— 'rec' 是**纯秒数**（`60` → `1`），
     'up' 是「**语音识别中**」5 个字（原文案「更新中」只有 3 个字）。
     遮罩宽 ＝ 节点宽，小节点（如「新增节点」）放 5 个字本来就紧
     ⇒ 钉住不折行：宁可略微溢出，也不要折成两行把卡片撑高。 */
  white-space: nowrap;
}

/* ⚠️ 第 112 轮**删除**：`.mm-node.edit { padding: 0 }` / `.mm-node-in` / `.mm-node-li`
   （含 `.mod-port` 那三条覆盖）—— 它们是 70/82/86/87/88/89 六轮里"把输入控件塞进卡片"
   那条路线的全部遗产：卡片让位、竖排容器铺满整卡、一片一行 input 逐档对齐行高……
   用户第 112 轮换思路之后这些**全都不需要了**（输入框搬去底部浮条，见 `.mf-ta` 那一段）。
   ⚠️ 留这段墓碑是给后来的人指路：`.mm-node.edit` 这个类名**还在**，
      但它的语义已经从"卡片换成输入框"变成"**卡片闪一下**"（见文件上半段 `mm-flash`）；
      别照着历史把 `padding: 0` 加回来 —— 加了只会让文字整体挪几像素，
      而编辑面板在别处，什么也修不好。
   ⚠️ 同一条 `edit` 线上的 wxml（`wx:if="{{editId === item.id}}"` 那段）与
      js（`editLines` / `editFocus` / `editW` / `editH` / `onEditLine` / `onEditDone`）
      也一并下线了。 */



/* ---------------- 节点操作浮条 · **容器内左下角**（09-21 第四轮建 · ★★ 第 253 轮换落点 + 减重） ----------------
   参考版（frontend-static参考版/components/mindmap-graph）的做法是「画布内侧一条
   通栏工具条，圆形图标钮 44×44、内容随选中态切换」。这里按同一形态落地，
   但只保留**节点级**动作，且配色沿用本工程令牌（--chip / --yellow / 紧急红浅底），
   所以视觉仍是这一套，不会跟其余四页分家。
   · 外层 .mm-float-wrap 负责「贴左下 + 让点击穿透」；分隔出内层 .mm-float，
     动画就不必和 translateX(-50%) 打架。
   ★ 第 81 轮第 4 条（**触控放大**）：圆钮 40 → **44**、图标 20 → **24**、
     组间距 10 → **12**、内边距 8 → **10** ⇒ 整条高 56 → **60**。
     用户口径「上下两组按钮都有点偏小，需要适当放大按钮图标，并适当拉大一些距离，
     这样触控起来更轻松」。
   ★★ 253 轮按《脑图工具栏位置方案》改三件：
     ① **落点**：底部通栏居中 → **贴左下（left 12 / bottom 10）**，`justify-content: flex-start`；
     ② **外壳减重**：胶囊的 --frost 底 / 1px 描边 / --sh-float 阴影全撤（键底色收到 32 的 `.fb-tile`）；
     ③ 组间距 12 → **4**、竖线 24 → **17** ⇒ 整条高 60 → **44**。
   ★★★ 254 轮第 4 件（用户口径「上下两组操作栏应该整体加大 50%」）：
     ④ **整体 ×1.5**：热区 44 → **66**、视觉块 32 → **48**、图标 24 → **36**、
        圆角 10 → **15**、组间距 4 → **6**、竖线 17 → **26** ⇒ 整条高 44 → **66**。
   ★★★ 255 轮第 5 件（用户口径「1.5 倍又有点大了，稍微再缩小一点」＋
        「上按键区的右侧和上侧、下按键区的左侧和下侧离画布边框的间隔稍微有点大，
         需要减小一下并统一」）：
     ⑤ **整体 ×1.25**（相对 253 那版；相当于在 254 的 ×1.5 上再收 0.8333）：
        热区 66 → **56**、视觉块 48 → **40**、图标 36 → **30**、
        圆角 15 → **12**、组间距 6 → **5**、竖线 26 → **21** ⇒ 整条高 66 → **56**。
     ⑥ **贴边按"看得见的那块"对齐**：热区（透明 56）贴到画布边 0，于是
        **视觉块 40 离画布边 8**（＝ (56−40)/2），四个角都是这 8。
        为什么不是"热区贴 8"：那样块离边就是 8 ＋ 8 ＝ 16，而左上的比例胶囊（贴着画布边量）
        只会是 8 ⇒ 一左一右两个角的"可见间距"差 8px，读起来还是没统一。
        用户第 3 条要的"和上下按键区一样"，比对的必然是**肉眼能看见的块**。
        （热区贴 0 无副作用：它是透明的，点击不被裁；按下 scale(0.92) 是缩小；
          语音光圈外扩 8 正好填满块到边这 8，也不会溢出画布。）
   ⚠️ 尺寸必须与右上那条**成对**（`.mm-top` / `.mm-tools`）：h 56 / gap 5 / sep 21。
      `工具/check_safe_band.js` 拿 `BAR_H` / `BAR_GAP` 与这里的真值逐值对撞，单边改就报红。
   ⚠️ 宽度账（255 轮重算）：5×56 ＋ 2×(1＋5) ＋ 6×5 ＝ **322**，
      横屏内宽 1168 / 竖屏内宽 768 都富余（254 那版是 380，253 是 254）。
   ⚠️ 为什么不再用"44/32 等比"那套档位：56 / 40 / 30 / 12 / 5 / 21 是一整组**整数**，
      彼此仍守 1.25 的比例；写成 55/40/30 会让热区与视觉块的余量左右不等（7.5 : 7.5 变 7.5），
      56 让 (56−40)/2 ＝ 8 与块到画布边那 8 **同值**（热区贴 0，块内缩 8），呼吸光圈正好落在这 8 里。 */
/* ★★ 第 112 轮：`height: 60px → auto` —— 这条浮条的容器**要能长高**了。
   底沿由 `bottom` 钉死，高度交给内容 ⇒ 编辑面板"**底不动、顶往上长**"
   （用户第 2 条原话"整个工具栏高度自适应加高，底部位置不变顶部向上平移"）。
   ⚠️ 静止态**逐元素不变**：里面只有 `.mm-float`（它自己 `height: 44px`）⇒
      容器 auto 高就是 44，与「内层多高、外层多高」这条契约一致。
   ⚠️ 别在这儿补 `max-height` 或 `overflow: hidden` —— 那会把面板切掉一半，
      而且切得**很隐蔽**（面板本身是白的、切在中间看不出来）。
   ★ 253 轮：`right: 0` 换成 `right: auto` ＋ `max-width: calc(100% - 24px)`。
     为什么要显式给 `max-width`：`left` 定了、`right` 为 auto ⇒ 宽度是**收缩适应**，
     宽度回到"内容多宽"；不给上限的话，编辑面板（440）在窄形态下会顶出画布右沿。
     `max-width` 一兜，`.mm-float.editing` 自己的 `max-width` 才有可算的参照。
   ★ 255 轮：`left 12 → 0`、`bottom 10 → 0`、`max-width: 100%`
     —— 热区贴到画布边，"看得见的块"因此离边 (56−40)/2 ＝ **8**（见上一条 ⑥）。
     ⚠️ 别再按"贴边 8"去改这四个数：热区贴 8 ⇒ 块离边 16，与左上那枚胶囊（贴边 8）差一整档。
     ⚠️ `max-width` 同步成 `100%`（原来减 24 是给左右贴边让的位，现在不需要了）。
     ⚠️ **但面板要另外让**：编辑态那块白卡没有"热区留白"可借，`.mm-float.editing` 自己带
        `margin: 0 8px 8px` ＋ `max-width: calc(100% - 16px)` —— 那 16 不是给 wrap 的贴边，
        而是给面板左右各 8 的呼吸。两处别混为一谈。
   ★★★ 256 轮（用户口径「四边的边距从 8 改为 12，目前又有点太小了」）：
     ⑦ **可见块离边 8 → 12**。热区贴边量因此 `0 → **4**`（4 ＋ (56−40)/2 ＝ 12），
        四个角一起走；左上那枚比例胶囊也 `8 → 12`（它本身就是"可见块"，没有热区差）
        ⇒ 四边仍然**同值 12**，对角那两条依旧是镜像。
        ⚠️ 别再把这里写回 0：热区贴 0 时可见块离边恒 8，而用户要的 12 量的是**看得见的那块**
           到画布边的距离 —— 差 4px 在 8.8″ 屏上正好是"一眼看得出偏紧"的那一档。
        ⇒ 安全带 `SAFE_T` / `SAFE_B` 随之 64 → **68**（4 ＋ 56 ＋ 8），`check_safe_band.js` 逐值对撞。
     ⚠️ 面板的 `margin: 0 8px 8px` **一个字不动**：它落在 wrap 内（4）之上 ⇒ 白卡离边
        4 ＋ 8 ＝ **12**，与按键的可见块、比例胶囊完全同值。三者同源，别分开手调。 */
.mm-float-wrap {
  position: absolute;
  left: 4px;
  right: auto;
  bottom: 4px;
  /* ★ 256 轮：热区贴边 4 ⇒ 限宽 `100% → calc(100% - 8px)`，左右各让 4。
     ⚠️ 它同时是 `.mm-float.editing` 的 `max-width: calc(100% - 16px)` 的参照：
        (100% − 8) − 16 ＝ 100% − 24，正好等于"左右各 12 之后剩下能用的宽" ⇒ 两处自洽。 */
  max-width: calc(100% - 8px);
  height: auto;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  pointer-events: none;
  z-index: 6;
}

/* 内层实体：静止态**只有一排键**（253 轮起不再有底/边/影）。
   ⚠️ `animation: fb-in` 留着 —— 换落点之后这条"从下往上 8px 淡入"依然成立（它仍在底部）。
   ★ 254 轮：h 44 → **66**、gap 4 → **6**（键整体 ×1.5，与 `.mm-top` / `.mm-tools` 成对）。
   ★ 255 轮：h 66 → **56**、gap 6 → **5**（同上，与右上那条成对）。 */
.mm-float {
  height: 56px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 5px;
  pointer-events: auto;
  animation: fb-in 220ms cubic-bezier(0.4, 0, 0.2, 1) both;
}

@keyframes fb-in {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ==========================================================================
   ★★★ 第 112 轮 · 节点文本**编辑面板**（用户换思路后的形态）
   ──────────────────────────────────────────────────────────────────────────
   用户口径（逐字）：「整个节点内容编辑区要嵌入到底部节点操作工具栏中，整个工具栏高度
   自适应加高，底部位置不变顶部向上平移，原有的工具栏按键在整个展开的工具栏顶部展示，
   中间为 textarea，底部有"取消""保存"按键。」
   ⇒ 一行一行的落点：`.mf-row`（键排·顶部）／ `.mf-ta`（textarea·中间）／
     `.mf-acts`（取消·保存·底部），三个都挂在**同一条 `.mm-float`** 里。

   ⚠️⚠️ **一条规则就能表达的关系，不要拆成"量→回调→setData→下发"**（铁律 108）：
      这里"高多少、圆角多少、谁在谁上面"全部由 CSS 自己算 ——
      面板高度 ＝ 内容自动撑开；内层宽度 ＝ `100%` 减 padding。
      JS 侧**一个几何量都不算**（对比：82–89 那版要 `editW/editH` ＋ 一次 `selectAll`
      量矩形再 `setData` 回去，见 `记忆-工程细节.md` 第 82 轮）。

   ⚠️ 为什么静止态能保持"逐像素同款"：
      `.mm-float` 是 `flex-direction: row` ＋ `align-items: center`，`.mf-row` 是它**唯一**
      的子项；`.mf-row` 自己的排法与原来那排平铺的键**逐字相同**（同样的 `gap: 12px`）⇒
      键的位置、整条的宽高都不变。改形态只发生在挂上 `.editing` 之后。
   ========================================================================== */

/* 键排 —— 五颗键 ＋ 两道竖线的**行容器**（分组与顺序一个字没动）
   ⚠️ `justify-content: center` 只在**展开态**看得出来：那时外层 `align-items: stretch`
      把这一行拉到面板满宽（440 − 24 ＝ 416），五颗键居中；静止态这一行的宽度就是内容宽
      （一条 380 宽的键排），居中是个空操作 ⇒ 不影响原来那副样子。
   ★ 253 轮 `gap: 12 → 4`；★ 254 轮 `4 → 6`（键整体 ×1.5）；★ 255 轮 `6 → 5`（收到 ×1.25）
      —— 与静止态那两条键排（`.mm-float` / `.mm-tools`）**必须是同一个数**，
      编辑面板的键排就是原来那一排原地往上走，间距一变就会"展开时键忽然散开"。 */
.mf-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 5px;
}

/* 展开态：同一条胶囊由「横条的键排」变成「竖排的面板」 —— 底沿不动、向上长
   ★★ 253 轮：**外壳必须穿回来**。
     静止态那条壳（--frost 底 / 描边 / 阴影）随"减重"一起撤掉了，但面板是**装字的白卡** ——
     没有底就是一行深色字浮在画布上，读不成"输入区"。所以底/边/影在这里重新给上，
     并且是这一轮唯一还留着 `--sh-float` 的地方（它确实是"浮起来的一块面"，不是一条键排）。
   ★★★ 255 轮：**面板要自己留出 8**。
     外层 `.mm-float-wrap` 这一轮改成贴画布边 0（为了让键的**可见块**离边 8），
     而面板是块**实心白卡**、没有"热区 vs 视觉块"这层缓冲 ⇒ 不给 margin 的话它会紧贴画布左沿与下沿，
     边框直接压在卡片边缘上（比 253 的 12 / 254 的 8 都更贴）。
     `margin: 0 8px 8px` 只挂在 `.editing` 上 —— 静止态那条键排**没有** margin，
     它的"离边 8"由热区内部那圈留白给（见 `.fb-btn` 的 56/40）。
   ★★★ 256 轮：**面板里不再有键排**（用户口径「当编辑弹窗打开时，弹窗顶部不显示按键……
     干脆就不显示按键了，用户保存或者取消之后再显示按键」）。
     ⇒ 展开态的子项只剩 **textarea ＋ 取消/保存** 两行；`.mf-row` 由 wxml 的 `wx:if` 直接不渲染，
        CSS 这边一个字都不用为它让位（`padding` / `gap` 不必改成"两行版"）。
     ⚠️ **省下来的那 68（键排 56 ＋ 一段 gap 12）全部给正文区**：
        `mod-mindmap.js` 的 `TA_MAX_H` 208 → **276**，面板整高仍是 **356**
        （276 ＋ 44 ＋ 12 ＋ 24 ＝ 356，用户点名认可过的那个数，也是手机端键盘弹起后放得下的那档）。
        ⇒ 两处**必须联动**：这里若哪天把 gap / padding 改回去，`TA_MAX_H` 要跟着反向走。
     ⚠️ 为什么不是"面板变矮到 288"：用户抱怨的正是"编辑弹窗能显示文字的面积变小"，
        键排让出的高度本来就该还给文字，而不是让整块面板缩一截。
   ★ 256 轮贴边：wrap 现在 `left / bottom: 4`，面板再加 `margin 8` ⇒ 白卡离画布边
     **12**，与按键的可见块、左上比例胶囊三处同值。 */
.mm-float.editing {
  flex-direction: column;
  align-items: stretch;
  height: auto;
  padding: 12px;
  border: 1px solid var(--hairline);
  border-radius: 20px;
  background: var(--frost);
  box-shadow: var(--sh-float);
  gap: 12px;
  box-sizing: border-box;
  /* ★★★ 275b：编辑态**不做入场位移**（覆盖 `.mm-float` 那条 `fb-in`）。
     两个理由，第二条是硬的：
       ① 编辑态的"入场"就是用户点「编辑」那一瞬间，一个 8px 的位移除了让人以为
          "弹窗抖了一下"之外没有信息量；
       ② **`animation` 的 `both` 会把 `transform: translateY(0)` 永久留在元素上**
          —— 带 `transform` 的祖先里，原生 `textarea` 的绘制位置与 CSS 盒会错开
          （同层渲染下它按"未变换坐标"画），症状正是"文字相对输入框错位"。
          编辑面板里那个唯一的输入控件就是 textarea ⇒ 这条动画对它只有坏处。
     ⚠️ 静止态的键排**保留** `fb-in`（那是"从下往上淡入"的观感，用户点名要的）。 */
  animation: none;
  /* 面板宽度：够写一句话、又不会在 1168/768 的内宽里显得空。
     ⚠️ 用 `width` ＋ `max-width: calc(100% - 16px)` 而不是写死 —— 万一将来上更窄的形态，
        它自己会退成"占满可用宽（略去左右各 8）"，不会溢出去。
     ⚠️ 减的是 16 ＝ 上面那条 margin 的左右各 8：`max-width` 按**父盒内宽**算，
        不减这 16 就等于让右边多出 8、被 `.mm-card` 的 overflow 裁掉一条边（静默）。 */
  width: 440px;
  max-width: calc(100% - 16px);
  margin: 0 8px 8px 8px;
}

/* 正文区 ＝ **唯一的输入控件**（第 112 轮的全部意义就在这一行把输入框移出卡片）
   ⚠️ 高度**写死**、不用 `auto-height`：铁律 106 —— 那个属性只认真机键盘的实时输入，
      模拟器上永远不长，而我们又要靠它给面板定高 ⇒ 面板高度会变成"看环境"。
   ⚠️ `box-sizing: border-box`：它同时有 `width: 100%` 与左右 padding。
   ⚠️ 字号 15 / 行高 22 是**面板自己的**一套，**刻意不与节点对齐**：编辑区在卡片外，
      "内外字号一致"这条约束已经不存在了（那正是用户换思路要摆脱的东西）。
   ⚠️ 它是原生组件，**不吃祖先 `transform`**（字号不随画布缩放变）——
      现在这反而是优点：面板在卡片外、尺寸固定，缩放画布不会把输入框一起缩。

   ★★★ 第 219 轮 · 高度改成**按文本自适应**（用户报：PC 上节点文本一长，输入框里只剩三四行、
   内侧滚出滚动条，滚它还顺带把背后的画布缩放了）。
   ── 现在的口径（两条，缺一不可）────────────────────────────────────────────
      ① **高度随文本**：开面板时按节点原文算、每敲一下重算 —— 见 mod-mindmap.js 的
         `taHOf` / `TA_MIN_H` / `TA_MAX_H`，值走 textarea 的**行内 style**；
      ② **上限 276**（面板整高 ＝ 276 ＋ 44 ＋ 12 ＋ 24 ＝ **356**，用户认可的那个数）。
         ⚠️ 256 轮：编辑态不再渲染键排 ⇒ 组成从「220 ＋ 键排 56 ＋ 44 ＋ 24 ＋ 24」变成
            「276 ＋ 44 ＋ 一段 gap 12 ＋ 24」。上限只与**面板里实际存在的行**有关，
            键排哪天再回来，这个数必须同步退回去。
   ⚠️ 下面这条 `height: 96px` **不是死高**，它现在只是**下限 ＋ 首帧兜底**：
      JS 还没算出内联高之前、以及文本很短（≤3 行）时，正文区就是这一档 —— 与 112 轮那版同值。
   ⚠️ 别改成 `min-height` / `max-height`：`.mm-float.editing` 是 `height: auto`，
      百分比高度在"父高不定"时按 auto 处理 ⇒ 两条都拿不到可算的值；而 `height` 是实的，
      行内再覆盖它即可（行内优先，原生 textarea 认行内 `height`）。
   ⚠️ 为什么不加 `vh` 兜底：vh 是**屏幕**的 px 而这里全是**画布**的 px，s≠1 时两者不同源
      （iPad 横屏 s≈0.885、手机 s≈0.959）—— 写了等于埋一把错尺子。
   ── 上限为什么不能随便往上抬（往上加之前先算这两笔账）────────────────────
      · **卡片顶**：面板是 `bottom: 4px` 往上长、`.mm-card` 又是 `overflow: hidden`
        ⇒ 面板一旦高过卡片，被切掉的正是**顶部那行正文**，而且切得很隐蔽（白底切白底）。
        最矮的一档是手机端（`PHONE_BASE` 400×880、卡片 ≈ 695 CSS）：键盘弹起
        （`adjust-position` 默认 true 把面板顶起来）后 356 ＋ 键盘 ≈ 650 ＜ 695 ✔
        ⇒ 手机端才是这条的上限，不是 PC。256 轮**面板整高没变**（还是 356），
          只是把原本给键排的 68 挪给了正文 —— 这条约束一个字都没松。
      · **它读的是设计稿 px**：会跟 `.stage` 的 `scale(s)` 一起缩
        ⇒ 1280×800 / iPad / 手机三档上的**视觉行数是一致的**，不需要按形态分叉。 */
/* ★★★ 275c：**框与字拆成两层**（用户第二次报"textarea 和外框有错位，没有充满外框"）
   ──────────────────────────────────────────────────────────────────────────
   这一条是 `.mf-ta-box`（普通 view，画框）＋ `.mf-ta`（textarea，只排字）。
   为什么必须拆，见 wxml 里那一大段；这里只钉住三件事：

     ① **padding / 描边 / 圆角 / 底色全部搬到 `.mf-ta-box` 上**。
        普通 view 认 `box-sizing: border-box` ⇒ 行内 `height` 就是眼睛看到的高，
        与 flex 布局逐像素一致，下面的"挂图区 / 取消保存"就贴在它下沿、不会空出一条带子。
     ② **`.mf-ta` 上不许再出现 padding / border / height 的 CSS 值**。
        它现在只剩"字 + 滚动"，盒模型两种算法在它身上等价 —— 那条
        "原生控件不认 border-box ⇒ 高宽各溢出 20"的坑从根上没有了。
        高度走行内 `editTaBodyH`（＝ `editTaH − TA_BOX_EXTRA`，js 算好，见 `taBodyHOf`）。
     ③ `overflow-y: auto` 留在 textarea 上（滚动是它自己的事）——
        241 轮那三条 `::-webkit-scrollbar` 也照旧，选择器没变。 */
.mf-ta-box {
  /* 下限／首帧兜底：JS 还没算出内联高之前就是这一档（与 112 轮同值）。
     ⚠️ 这里写 `height` 是实的，行内再覆盖 —— 别改成 min-height（父是 height:auto，
        百分比高度按 auto 处理，拿不到可算的值）。 */
  height: 96px;
  box-sizing: border-box;
  /* ⚠️ 定高的 flex item 必须钉住（铁律：`flex: 0 0 auto`）。不钉的话，面板里
     「正文 ＋ 挂图区 ＋ 两个键」一旦超高，flex 会先压这一项 ⇒ 框变矮、字被裁，
     而且**判据量不出来**（判据只算纸面数字）。 */
  flex: none;
  /* ★★★ 275f：左右 `10 → 8`（用户第五次报"右侧始终有空隙"）。**不是**为了好看，
     是为了让正文区多出 4 设计稿 px 的余量 —— 病根见 `.mf-ta` 那段「行末余量」，
     一句话：原来 392 ÷ 15.08 ＝ **25.995**，差 0.08px 挤不下第 26 个字 ⇒ 每行末尾
     整整空掉一个字的宽度。撑到 396 ÷ 15.08 ＝ 26.26 ⇒ 第 26 个字进得去，余量只剩 ~3px。
     ⚠️ 上下 `9` 不动：`TA_BOX_EXTRA ＝ 20`（9＋9＋描边 2）是高度那条链的一环，
        只改左右就等于把高度算错 4px。 */
  padding: 9px 8px;
  border: 1px solid var(--hairline);
  border-radius: 10px;
  background: var(--card);
  /* ★★★ 275d：给里面那个 textarea 当**包含块**（下面那段 `position: absolute` 靠它）。
     ⚠️ 绝对定位的子元素相对**padding box**（＝描边内沿）定位，与 padding 无关 ——
        所以 padding 留着只是为了记下"内距 8 / 9"这个设计值，
        真正生效的是 `.mf-ta` 的 `left/right/top/bottom`。**两处必须同值**（判据现读对撞）。
     ⚠️ 同时开 `flex` 是**第二道保险**：万一哪档基础库对原生控件的绝对定位解析有差池
        （绝对定位失效 ⇒ textarea 退回普通流），它至少还是一颗 flex item，
        `align-self: stretch` 会把它撑到容器满宽 —— 比 `width: auto` 缩成 fit-content 好得多。
        两套规则互不干扰（绝对定位生效时它已经脱离 flex 布局）。 */
  position: relative;
  display: flex;
  flex-direction: column;
  /* 兜底裁切：原生控件万一带出 1px 的溢出（基线缝 / 默认 min-height），
     就在这一层裁掉 —— 宁可裁掉 1px，也不要它顶开下面的挂图区。 */
  overflow: hidden;
}

.mf-ta {
  /* ★★★ 275d：**四边钉死**，宽度不再交给 `width: 100%`（用户第三次报这个面板的框）。
     ⚠️⚠️ **但 275d 只治住了"高度那条链"，宽度没治住** —— 真机 iPad mini 上右边仍空
        34 屏px。`left/right` 在替换元素上会被判"过度约束"、`right` 直接丢掉，
        宽度退回固有宽。275e 已改由行内 `editTaW` 写死 px，见本块下半段。
     ── 实测现象（用户口径）────────────────────────────────────────────────
        「MatePad mini 时 textarea 能基本充满外框，iPad mini 就又出现 textarea
          右侧与外框有间隙」—— 同一份代码、同一个 `height`，只有**宽度**在 iOS 上不满。
     ── 为什么「只表现为右侧」───────────────────────────────────────────────
        左侧留白是**外框**给的 `padding-left: 10`（普通 view，确定值）；
        右侧留白 ＝ `padding-right` ＋「textarea 比父内容盒窄的那一截 Δ」。
        ⇒ `width: 100%` 只要少算 Δ，整笔误差就全堆在右边，左边一点不变。
        反过来也解释了为什么 MatePad 上"基本充满"：那边 Δ ≈ 0。
     ── 275d 当时以为"改成绝对定位就能治"，结果**不能**（开头那条 ⚠️）──────────────
        `width: 100%` 是**元素自己算**的（解析父内容盒再乘百分比）；
        `left + right` 是**父的矩形减去两个偏移** —— 275d 的推理到这儿是对的，
        漏掉的是"`textarea` 是替换元素"这一层：宽度有解时它判**过度约束**、
        LTR 下丢掉 `right`，长宽又退回固有值。推理对、结论错，就是这一处。
        ⚠️ 四个偏移必须与 `.mf-ta-box` 的 `padding` 同值（左右 10 / 上下 9），判据现读对撞。
     ── 高度两条路一致 ──────────────────────────────────────────────────────
        `top 9 ＋ bottom 9 ＋ 描边 2` ⇒ 内容高 ＝ `editTaH − 20`；
        行内 `editTaBodyH` 也是 `editTaH − 20` —— 同一个数，行内那条留着当兜底
        （老基础库对绝对定位的解析若有差池，还有它顶着）。 */
  position: absolute;
  /* ★★★ 275f：左右 `10 → 8`，与 `.mf-ta-box` 的 `padding: 9px 8px` **必须同值**。
     这两个偏移只决定"字从哪儿起排"（左）与"含块有多宽"（右）；右边那条在
     行内 `width` 生效时会被判过度约束丢掉，所以**改宽度只认行内 `editTaW`**。 */
  left: 8px;
  right: 8px;
  top: 9px;
  bottom: 9px;
  /* ★★★ 275e：**宽度真正的出处是行内 `editTaW`（设计稿 px），这条 `auto` 只是老基础库兜底。**
     ── 275d 的 `left/right` 为什么没治住（用户第四次报，真机 iPad mini 量出来的数）──
        外框 359 屏px（＝414×0.868，逐像素对得上）、左侧内距 11 屏px（＝11 设计稿 px，准）、
        右边却空 34 屏px；文字 26 字占 314 屏px ⇒ 正文区实际只有 **362 设计稿 px**，
        比外框内容盒 392 少 **30** —— 也就是"字的框"比"画的框"窄了一截。
        同一份代码在 MatePad 上几乎看不出，是因为它那档 `s` 更接近 1（差的那截被缩小了）。
     ── 病根：`textarea` 是**替换元素** ──────────────────────────────────────
        · `width: auto` ⇒ 取**固有宽**（跟父内容盒无关）⇒ 275d 这条 `right` 就成了摆设；
        · `left ＋ right` 同时在且宽度有解 ⇒ 判"过度约束"，LTR 下**丢掉 `right`**。
        两条路殊途同归，都停在同一个固有宽上 —— 这就是为什么 275b（`width: 100%`）
        和 275d（`left/right`）症状一模一样，改法看着都"做了对的事"却没效果。
     ── 现在的口径 ──────────────────────────────────────────────────────────
        宽度行内写死成设计稿 px（`editTaW`：宽形态 396 ／ 手机 298），与高度同一次 setData；
        这里保留 `left/right/width:auto` 三条**只作为兜底**（老基础库不认行内宽度时，
        退回 275d 那套"至少左边对、右边差一截"的行为，而不是彻底跑偏）。
     ⚠️ 别再往这里加 `width: 100%`：理由同 275d（写死百分比 ⇒ `right` 失效），
        而且百分数在原生控件上本来就解析不可靠 —— 275e 的教训是"要 px，不要百分比"。
     ⚠️ `align-self` 是**绝对定位失效时**的兜底：那时它退回普通流、成为 `.mf-ta-box`
        的 flex item（外框开了 `flex-direction: column`）—— `stretch` 把它撑到容器满宽。
        绝对定位生效时这条不起作用（已脱离 flex 布局）。

     ── 275f：宽度对了，为什么右边**还是**空一截（用户第五次报）─────────────────
        把两天的真机截图逐像素量完，结论是：**框早就是对的，空的是"行末余量"。**
          · MatePad：外框 341 屏px ÷ 414 设计 ＝ s 0.826；首字墨迹左沿 14、内沿 6
            ⇒ 左内距 8 屏px ＝ 9.7 设计 ≈ padding 8＋描边 ✔ 分毫不差；
            每行 25 个字、字距 12.46 屏px ＝ **15.08 设计稿 px/字**（不是标称的 15）。
          · 关键算式：**392 ÷ 15.08 ＝ 25.995** —— 差 **0.08px** 挤不下第 26 个字
            ⇒ 每行末整整空掉一个字的宽度（15 设计 px），而且这 15px 是**空在正文区
            里面的**，不在 padding 里 ⇒ 右边看起来 ＝ 8 ＋ 15 ＝ 23，左边只有 9。
        这也是它"怎么改宽度都没变"的原因：改法一是没生效（275b/c/d），二是一旦生效，
        余量就只由「正文区宽 ÷ 字宽」的**余数**决定 —— 余数落在 0 附近就满，落在 1 个字
        附近就空一整行尾。**这不是布局问题，是栅格问题。**
         ⇒ 两手一起治：
           ① **把正文区撑到能装下第 26 个字**（392 → 396，见 `.mf-ta-box` 的 padding 8）：
              396 ÷ 15.08 ＝ 26.26 ⇒ 余量只剩 ~3px，左边 9 ／ 右边 11，读起来就齐了；
           ② **`text-align: justify`**（下面那条）：中文两端对齐，满行一律拉到与正文区
              等宽 ⇒ 从此**余数是多少都不影响观感**，只有最后一行（本来就该短）留着余量。
              ⚠️ 这是唯一一条"不依赖字宽猜测"的治法 —— ①是调数，换台机器字宽变了就又要重算。
              ⚠️ 已验证 Chromium（Edge 无头）上 textarea 认这条：同一段文字、正文区 396，
                 左对齐时首行墨迹止于 419，justify 后止于 425（正文区右沿 427）✔
              ⚠️ 末行**不会**被拉开（CSS 的 text-align-last 默认就是 start）—— 这正是要的，
                 否则末尾只有两个字的行会被撕成两半。 */
  width: auto;
  align-self: stretch;
  /* ⚠️ 三件"归零"是 275c 的核心，缺一件就又回到 content-box 那条坑上 */
  padding: 0;
  border: 0;
  background: transparent;
  display: block;
  /* 高度不在这里写（行内 editTaBodyH）；`box-sizing` 对没有 padding/border 的元素
     两种算法等价，写不写都一样，索性留一条显式声明防止将来有人加回 padding。 */
  box-sizing: border-box;
  /* 压掉原生控件的默认下限（小程序 textarea 不带 height 时有一档默认高）——
     短文本要能缩到 `editTaBodyH`（最矮 ≈76），被默认值顶住就又把外框撑破了。 */
  min-height: 0;
  /* ★★★ 275b：这两个数是**兜底**，真值由模板行内下发（`15×s` / `22×s`）——
     `textarea` 是原生控件，不吃祖先 `.stage` 的 `transform: scale(s)`，而框是吃的。
     只写这里 ⇒ 框缩字不缩 ⇒ 字比框大 4%~13% ⇒ 折行数与 `taHOf` 的估算对不上。
     ⚠️ 这里**不许删**：老基础库不认行内 `font-size` 时，至少有它兜着；
        但**也不许只留它** —— 两者是"真值 / 兜底"的关系，别互相当替代。 */
  font-size: 15px;
  line-height: 22px;
  color: var(--primary);
  /* ★★★ 275f：中文两端对齐 —— 满行拉到与正文区等宽，行末不再留"还剩几个字"的余量。
     这是本面板"右边总是空一截"的**根治**那一半（另一半是把正文区撑到 396），
     完整机制见本块上半段 275f 那段。不支持的引擎会静默退回左对齐（不报错、不跑版）。 */
  text-align: justify;
  /* ★★★ 第 241 轮：显式声明 overflow-y —— 让"装不下就滚"这件事不靠控件默认值兜。
     溢出的判定完全交给浏览器／原生控件（高度 ≥ 内容高时不出现滚动条，也没有空的槽）。 */
  overflow-y: auto;
}

/* ==========================================================================
   ★★★ 第 241 轮 · 正文区**溢出时的那条滚动条**（用户第 3 条）
   ──────────────────────────────────────────────────────────────────────────
   用户口径（逐字）：「输入框是可以根据文字长度进行自适应了，自适应有一个最大值也没问题，
   但是如果文字还是超出了高度，应该增加一个滚动条。」

   ── 为什么"加滚动条"这件事要分两半做 ──────────────────────────────────────
     ① **能滚**（根因）：textarea 上层的 `.mm-card` 与 `.mm-float-wrap` 都挂着
        `catchtouchmove`，微信同层渲染下它会**连输入框自己的滚动一起掐死**
        ⇒ 两处全部改 `bindtouchmove`，画布手势改由 JS 的 `_uiHold` 闸门挡。
        详见 wxml 里 `.mm-card` 与 `onUiTouch` 那两段注释。
        ⚠️ 这一半**只有它能救手机端** —— 手机上的 textarea 是原生控件，下面对 CSS 不认。
     ② **看得见**（本条）：自定义滚动条。Chromium 有个脾气值得记住 ——
        **只要某个元素定义了 `::-webkit-scrollbar`，它就从"系统浮出式（滚动才出现、
        一两秒后淡掉）"切成"自定义常显"**。所以这三条一写，PC／WebView 侧才是
        "多了一条滚动条"，否则只是"滚动时闪一下"，用户根本注意不到。

   ⚠️ 三条禁用（写错任一条，滚动条会**静默消失**，编译照样通过）：
      · **不许加 `scrollbar-width` / `scrollbar-color`**：新版 Chromium 里它们优先级更高，
        一旦出现就**关掉**整套 `::-webkit-scrollbar` ⇒ 退回系统浮出式。
        （注意与 `.sd-body` / `.p-area` 那批"用 `::-webkit-scrollbar { width: 0 }` 收掉
          滚动条"的老规则方向相反 —— 那里要"没有"，这里要"常有"，别互相抄。）
      · **不许写裸 hex**：浅色 `#8E91A0` 在深色卡底上直接看不见 ⇒ 走 `--stone`
        （深色那一档是 `#A7A8A3`，在 `#202123` 的卡上正好）。
        ⚠️ 别退一档用 `--hairline-strong`：浅色 `#C7CAD5` 在白卡上只有一点点影，
          2x 屏缩下来几乎读不出"这里有一条滚动条"（本轮先这么写、截图后否掉的）。
      · **不许改成 `overflow: scroll`**：那会让短节点（1 行字）也常驻一条空槽。
   ⚠️ 宽度取 **6**：`.mf-ta` 是 `box-sizing: border-box` ⇒ 滚动条从 padding 侧扣，
      内容宽 394 → 388。**看起来**这会让每行少放一个全角（26 → 25），
      但它只发生在"已经溢出"的那一档 —— 而溢出时高度恒为上限 220、
      滚动条本来就该出现，少算的那一行不改变任何可见结果；
      反过来，96–220 这段真正逐行自适应的区间里**根本没有滚动条**，
      `TA_EM_WIDE`(26) / `TA_EM_PHONE`(19，256 轮从 21 收回) 那两笔宽度账**一个都不用改**。
      ⚠️ 别为了"补回这 6px"去缩 `padding-right`：短节点（无滚动条）的文字会贴边，
         一改就是"明明只有一行字却顶着右边框"。
   ========================================================================== */
.mf-ta::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
.mf-ta::-webkit-scrollbar-track {
  background: transparent;
}
.mf-ta::-webkit-scrollbar-thumb {
  background: var(--stone);
  border-radius: 3px;
}


/* 底部两颗键 —— 操作键族（FR-8.6.4）：44 高 · 等宽 · 圆角 10 · 两变体。
   ⚠️ 与闪念胶囊编辑面板的 `.ep-btn` **同一套皮肤**（ghost ＋ primary：白描边 / 主墨底），
      只差高度 —— 那边是手机端 36，这边是本模块的操作键族 **44**（第 81 轮"触控放大"
      之后本模块的键一律 44，见 `.fb-btn`）。 */
/* ==========================================================================
   挂图区（★★ 275 轮）—— 直接复用 `<capsule-attach>`，本层只干一件事：**把间距对齐**。

   组件自己带 `margin-top: 6px`（它在胶囊面板里贴着的是一整块 `.ep-body` 块流，没有 gap），
   而本面板是 `gap: 12px` 的 flex 列 ⇒ 不压回 −6 的话这一段间距会变成 **18**，
   与下面「取消 / 保存」那道 12 对不齐（用户对"间距不一致"一向很敏感）。
   ⚠️ 负 margin 只对 **flex item** 生效 —— 本层正是 `.mm-float.editing` 的直接子项，成立。
   ⚠️ 别把组件内部尺寸（96×72 的坑）在这里改：那是胶囊面板与本面板**共用**的那一套，
      要改就得两处一起改，否则同一个"挂图 1 张"在两块面板里长得不一样。
   ⚠️ 这一块只在**非根节点**出现（`editImgOn`）⇒ 面板整高因此分两档
      （组成 ＝ padding 24 ＋ 正文 ＋ gap 12 ＋ 图区 72 ＋ gap 12 ＋ 按键 44）：
        · 根节点   ＝ 正文上限 220 ＋ 80 ＝ **300**
        · 其余节点 ＝ 正文上限 220 ＋ 164 ＝ **384**
      ⚠️ 220 这个上限是随图区一起**降下来的**（原 276），理由写在 `mod-mindmap.js`
         的 `TA_MAX_H` 那段：手机端键盘弹起后能容纳的面板高是硬的，图区占了 84，
         就只能从正文里匀出来 —— 否则被裁掉的正是**正在写的那几行字**。
   ========================================================================== */
.mf-attach {
  margin-top: -6px;
}

.mf-acts {
  display: flex;
  flex-direction: row;
  gap: 10px;
}
.mf-act {
  flex: 1;
  min-width: 0;
  height: 44px;
  border-radius: 10px;
  font-size: 15px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  /* ★★ 第 114 轮：文字前有小图标（`close` 取消 ／ **反白的** `w-check` 保存）。
     ⚠️ 漏的**只有本模块这一侧** —— 闪念胶囊编辑面板的 `.ep-btn`（并行会话 112 轮）
        与待办抽屉的 `.sd-cancel` / `.sd-submit` 早就长这样，值逐字同源。
     gap 取 6：**44 高这一族**（`.cp-btn` 6）与 36 高的
     `.dw-foot-btn` / `.sd-submit` / `.sd-del` / `.ep-btn` 同值；
     只有 28 高那一族的 `.cp-hbtn` / `.sd-cancel` 是 5。
     ⚠️ 图标尺寸**按键高分档、不按字号**：28 → 13/14 ／ 36 → 15 ／ **44 → 16**。
        本键是 44 ⇒ 图标 16（写在 wxml 上）。一开始差点按"图标 ≈ 字号"取 15 ——
        `.mf-act` 字号 15 而 `.cp-btn` 字号 14 却用 16 ⇒ 横向对齐的是**键高**。
     ⚠️ 垂直对齐不用另外补：两键都是 `box-sizing: border-box` + 对称的 1px 描边，
        内容区仍居中于外框 ⇒ ghost 与 primary 的图标落在同一水平线。 */
  gap: 6px;
  box-sizing: border-box;
}
.mf-act.ghost {
  background: var(--card);
  border: 1px solid var(--hairline-strong, #C7CAD5);
  color: var(--slate, #555A6A);
}
.mf-act.primary {
  background: var(--solid);
  color: var(--on-solid);
}
/* 按下反馈一律走 `hover-class`（★ 第 72 轮口径：`:active` 在真机上不保证生效）——
   ⇒ 在 wxml 上补 `hover-class`，CSS 这边只需要把两个按下态写出来。 */
.mf-act.ghost.fb-hit { background: var(--chip); }
.mf-act.primary.fb-hit { opacity: 0.82; }

/* ⚠️ 第 71 轮删除：`.nr-tag` / `.nr-dot` / `.nr-txt`（浮条最左侧那枚"选中节点气泡"，黄底胶囊）
   ＋ `.mm-float .nr-tag { margin-left: 4px }` ＋ 竖屏那条 `.mod-port .mm-float .nr-tag`。
   用户口径：「操作按钮栏在横版模式下左侧多了个节点气泡，这个要去掉，横版竖版要一致」——
   原来它是"横屏显示 ／ 竖屏 display:none"的两套形态，现在**两个方向都没有它**。
   ⇒ 紧跟它的那条 `fb-sep` 也从 wxml 删了（否则浮条会以一条孤零零的竖线开头）。
   ⚠️ "在改谁"这件事并没有一起丢：承担它的是**画布上节点自己的选中态**
      （`.mm-node.sel` 黑描边 ＋ 黄外发光）—— 竖屏从第 66 轮起就是这条路，
      画布上本来就看得见节点文字，横竖屏一致。 */

/* 按钮组之间的细分隔（★ 第 81 轮 22 → 24；★ 253 轮 24 → **17**；★ 254 轮 17 → **26**）
   ⚠️ 253 轮：键的**视觉**高度收到 32 之后，竖线若还留 24 会上下各冒出 3.5px，读起来像
      "竖线比键还高"⇒ 收到 17（≈ 一颗 32 键的内芯：图标 24 ＋ 上下各 4 的一半）。
   ★ 254 轮整体 ×1.5：17 × 1.5 ＝ 25.5 ⇒ 取整数 **26**（不取 24 —— 等比口径优先）。
   ★ 255 轮收到 ×1.25：17 × 1.25 ＝ 21.25 ⇒ 取整数 **21**（口径同前：等比优先，
      不按"视觉块 40 里的图标 30"去取 18 或 20）。
      两处（`.fb-sep` / `.mt-sep`）必须同步，否则两条工具条的竖线一高一矮。 */
.fb-sep {
  width: 1px;
  height: 21px;
  background: var(--hairline);
  flex: 0 0 auto;
  margin: 0 3px;
}

/* 圆形图标钮 —— ★★ 第 253 轮：**热区与视觉分离** · ★★★ 第 254 轮：整体 ×1.5 · ★★★ 第 255 轮：**收到 ×1.25**

   56×56 是**热区**，里层 40×40 的 `.fb-tile` 是**视觉块**。两层仍然分开，
   尺寸是一整组等比整数（相对 253 那版 ×1.25）：
     热区 44 → **56** ｜ 视觉块 32 → **40** ｜ 圆角 10 → **12** ｜ 图标 24 → **30**
   （验算：44×1.25=55→56、32×1.25=40、24×1.25=30；圆角 10×1.25=12.5 取 12。
    热区取 56 而不是 55 是**有意的**：(56−40)/2 ＝ 8，语音那颗呼吸光圈的外扩（8）
    正好落在这 8 里，不多不少 —— 光圈最远一帧贴到热区边界，不跨到相邻那颗。）
   ★ 256 轮：这条 8 **不再等于**"块到画布边的距离"了（那一项已随四边统一改成 12）：
      热区贴边 4 ⇒ 块离边 4 ＋ 8 ＝ 12。呼吸光圈那 8 仍在热区内部，口径不变。
   ⚠️ 254 那版是 66 / 48 / 36 / 15 —— 用户「1.5 倍又有点大了，稍微再缩小一点」。
      别再按"×1.5 的一半"去推，那一档是 55，与上面那条整数账撞不上。

   为什么非分两层不可：外壳减重之后两条工具条不再有胶囊外框，键的底色**直接落在白画布上**，
   而 `--chip` 恰好就是**节点方块**的底色（`mm-canvas.wxss` 的 `.lv1 / .lv2 / .lv3`）——
   热区那么大的方底会读成"一颗小节点"；40 的小圆角块 ＋ 1px 描边才读得出"这是控件"。
   ⚠️ 别把底色写回 `.fb-btn`：56×56 的实底会把"减重"整个吃掉。
   ⚠️ `opacity`（`.off` 灰态）与 `transform`（按下回弹）留在**外层** —— 它们要作用在整颗键上。
   ⚠️ 图标 30 的留白是 (40−30)/2 ＝ 5。图标尺寸写在 **wxml 的 `size` 属性**上，
      改这里不会带动图标 ⇒ 两处**必须一起改**（wxss 的 40/56 与 wxml 的 size=30 是同一笔账）。
   ★★★ 254 轮 · **窄屏可收缩**（`flex: 0 1 auto` ＋ `min-width: 40px`）：
      整条 322 宽，手机档（设计稿 400 宽）的画布内宽现在只有 344（`.mm-float-wrap` 的
      `max-width: calc(100% - 8px)`，256 轮起左右各让 4）⇒ 5 颗 56 的键放不下。
      这里只允许**热区**被压：`min-width: 40` ＝ 视觉块宽，压到极限时键挨着键、图形一个不少。
      宽屏（横屏 1168 / 竖屏 768）有富余 ⇒ `flex-shrink` 根本不生效，**逐像素等于无收缩**。
      ⚠️ 别改成 `flex: 0 0 auto` —— 那会让手机上最右边「删除」被裁掉一截（静默，不报错）。
      ⚠️ 也别把 `.fb-tile` 写成百分比：视觉块一旦跟着缩，图标 30 就会溢出块外。 */
.fb-btn {
  width: 56px;
  height: 56px;
  min-width: 40px;   /* 热区可被压到"视觉块宽"为止，再小就压到邻居了 */
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 1 auto;    /* ★ 254：可收缩（窄屏兜底），宽屏有富余 ⇒ 不生效 */
  -webkit-tap-highlight-color: transparent;
}

/* 视觉层：40×40 · 圆角 12 · 1px 描边。
   ⚠️ `box-sizing: border-box`：描边不许把这层撑到 42（否则整条键排比算好的宽度宽两圈）。 */
.fb-tile {
  width: 40px;
  height: 40px;
  box-sizing: border-box;
  border-radius: 12px;
  border: 1px solid var(--hairline);
  background: var(--chip);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 按下态（★ 第 72 轮：`:active` → `hover-class`）——
   微信官方「体验评分」明文列为待修项：「**避免使用 `:active` 伪类来实现点击态**……
   建议使用小程序内置组件的 `hover-class` 属性来实现」
   （得分条件：不使用 `:active`，并用 `hover-class` 替换）。
   为什么这与用户报障直接相关：`:active` **在真机上不保证生效** ⇒ 手指按下去
   屏幕上**没有任何变化**，用户无法区分"点到了但动作无效果"和"根本没点中"，
   最终都读成「点击以后没有反应」。而这两条工具条此前**唯一的按下反馈**就是它。
   ⚠️ 只换底色（#F1F2F5 → #E0E2E8）色差太弱，再叠一点 `scale`：
      8.8″ 屏上"按下回弹"比"底色深一档"可靠得多。
   ⚠️ `scale` 是这里**唯一不会被别的规则盖掉**的那一维：删除键的 `.arm` 武装态
      底色与按下态同值（#FBD9DB），靠底色看不出区别，但缩放在任何态都还在。
   ⚠️ 灰态（`.off`）**照样给按下态** —— 与"灰态故意不关 `pointer-events`"同一条口径：
      灰说明"这颗此刻没有效果"，不等于"点不到"；按下有反馈，才好把这两件事分开。
   ★ 253 轮：底色那一半整条挂到 `.fb-tile` 上（`transform` 留在外层）。 */
.fb-btn.fb-hit { transform: scale(0.92); }
.fb-btn.fb-hit .fb-tile { background: var(--hairline); border-color: var(--hairline); }

/* ⚠️ 第 81 轮**删除** `.fb-btn.yellow` / `.fb-btn.yellow.fb-hit` 两条 ——
   「增加子节点」原来挂一层淡黄（常态 `#FFF4C4`，按下 `#FFEAA0`）做强调。
   用户口径（第 3 条）：「目前的'添加子节点'有个淡黄色很突兀，建议按钮统一一下，
   删除使用现有的颜色没问题」⇒ 那层黄去掉，五颗一律走 `.fb-btn` 的 `--chip`；
   「删除」保留它原有的紧急红浅底（用户点名"没问题"）。
   ⇒ **底色账**（第 81 轮现状，一眼看完）：常态 = `--chip`，只有「删除」是 `--u-urgent-bg`；
      按下 = `--hairline`，「删除」按下/武装 = `#FBD9DB`。
      💡 与底色无关的**瞬时状态**仍在（它们不是"某个键长得不一样"，是"这一刻在发生什么"）：
         · `.rec` 录音中 —— `--yellow-soft` ＋ 呼吸光圈（第 70 轮用户口径："此时小麦克风
           也加呼吸式光圈进行提示"）；
         · `.on`  编辑中 —— `--yellow-soft`（与画布上那个输入框遥相呼应）。 */

/* 删除：平时紧急红浅底；**武装态**（第一段已点）底色加深 ＋ 图标换成 trash-red（正红）——
   用户口径："点击之后图标变为正红色，再次点击才能删除"。
   ★ 253 轮：底色落到 `.fb-tile` 上；描边同时换成同族的浅红（`--u-urgent-hit`），
     否则整排里唯独这一颗是"浅红底配灰边"，读起来像没对齐。 */
.fb-btn.del .fb-tile { background: var(--u-urgent-bg); border-color: var(--u-urgent-hit); }
/* ★ 94 轮：两处的裸写 #FBD9DB 收进 `--u-urgent-hit`（值未变）。
   ⚠️ 别顺手把它并进 `--u-urgent-bg`：这两态与常态的**唯一区别**就是这个色（另一维是 scale），
      并掉 = 按下/武装看不出反馈（上面 L663 那段注释就是在说这件事）。 */
.fb-btn.del.fb-hit .fb-tile { background: var(--u-urgent-hit); border-color: var(--u-urgent-hit); }
.fb-btn.del.arm .fb-tile { background: var(--u-urgent-hit); border-color: var(--u-urgent-hit); }

/* 语音：录音中连键一起呼吸（用户口径"此时小麦克风也加呼吸式光圈进行提示"）。
   ⚠️ 只加**外扩**光环、不动内圈：塞 inset 环会显得像"选中了"，而这里要说的是"在录"。
   ★ 253 轮：光圈挂在 32 的 `.fb-tile` 上，最大外扩从 9 收到 **7** ——
     32 的块外面只剩 (44−32)/2 ＝ 6 的余量，9 会吃掉相邻那颗（键距只有 4）。
   ★ 254 轮：块 32 → 48、热区 44 → 66 ⇒ 余量 (66−48)/2 ＝ **9**，外扩按等比 7×1.5 ≈ **10**。
   ★ 255 轮：块 40、热区 56 ⇒ 余量 (56−40)/2 ＝ **8**，外扩随之 **10 → 8**。
     ⚠️ 8 正好等于余量：光圈最远一帧恰好贴到热区边界，**不会**跨到相邻那颗的热区里
        （相邻两颗的**块心距**是 40 ＋ 5 ＝ 45，半程 22.5 ≫ 8，安全裕度很大）。 */
.mm-float .fb-btn.rec .fb-tile {
  background: var(--yellow-soft);
  animation: fb-breath 1.35s ease-out infinite;
}

@keyframes fb-breath {
  0%   { box-shadow: 0 0 0 0 rgba(255, 208, 47, 0.66); }
  70%  { box-shadow: 0 0 0 8px rgba(255, 208, 47, 0); }
  100% { box-shadow: 0 0 0 8px rgba(255, 208, 47, 0); }
}

/* 编辑：正在编辑该节点时这颗键保持点亮（黄底），与画布上那个输入框遥相呼应 */
.mm-float .fb-btn.on .fb-tile { background: var(--yellow-soft); }

/* 置灰 —— 两类场合共用：
     · 没有选中对象时（★ 第 81 轮起是**五颗**全灰，展开/收起已搬去顶部）·
       选中**根**时的「加同级 / 删除」两颗。
   ⚠️ 第 70 轮起这些键**不再"点了给 toast 说明"**（用户要求快速操作，够不着的动作
      按下去不响应就行）。但 `pointer-events` **故意不关** —— 关掉之后"置灰"
      在自动化里就变成一个点不到的靶子，判据不好写，也挡掉了将来可能的长按提示。 */
.fb-btn.off { opacity: 0.38; }

/* ⚠️ 第 70 轮删除：`.fb-ico.up`（把 chevron-down 翻转 180° 当"上移"用的那条）——
   随「上移 / 下移」两颗键一起撤掉。 */

/* ---------------- 脑图级工具栏 · **容器内右上角**（★ 第 81 轮建 · ★★ 第 253 轮换落点 + 减重） ----------------
   用途（与 81 轮完全相同，一个字没动）：
     · 右上这条管**整图 ＋ 选中那一支** —— 撤回 ｜ 重做 ‖ 展开 ｜ 收起 ‖ 编辑
     · 左下那条管**单个节点** —— 加子 ｜ 加同级 ‖ 语音 ｜ 编辑 ‖ 删除
       （★ 258 轮对调过组序：原来"语音｜编辑"在最左。见 wxml `.mf-row` 那段。）

   ★★ 253 轮按《脑图工具栏位置方案》改的两件事：
     ① **落点**：原来 `left:0;right:0;top:16` ＋ `justify-content:center`（通栏居中、压在图上沿正中），
        现在 `right:12;top:10;left:auto` ＋ `justify-content:flex-end` —— 贴右上角。
        为什么：上下两边的**正中间**是画布最贵的地方（三种纵向格式的根节点就在那里），
        而两条工具条各自的角是"画布上永远最空的四个角"中的两个 ⇒ 对角呼应，互不打架。
     ② **外壳减重**：整条胶囊的 `--frost` 半透明底 / 1px 描边 / `--sh-float` 大阴影**全部撤掉**，
        键的底色收到里层 40×40 的 `.fb-tile`（见 `.fb-btn` 那段）。
        ⇒ 整条高度因此从 60 落到 **44**（＝一颗键的高度），`--ch` 也跟着改，见 `mindmap-core.js` 的 `BAR_H`。
     ③ ★★★ **254 轮：整条 ×1.5** —— 用户口径「上下两组操作栏应该整体加大 50%」。
        条高 44 → **66**（＝新热区高度），键 32 → 48，图标 24 → 36，间距 4 → 6，竖线 17 → 26。
        贴边量（right 12 / top 10）那轮**没动**。
     ④ ★★★ **255 轮：整体收到 ×1.25 ＋ 贴边统一 8** —— 用户两条口径：
        「1.5 倍又有点大了，稍微再缩小一点」＋「上按键区的右侧和上侧距离画布边框的间隔
         稍微有点大，需要减小一下并统一」。
        条高 66 → **56**、键 48 → **40**、图标 36 → **30**、间距 6 → **5**、竖线 26 → **21**；
        `top / right` 从 `10 / 12` 收到 **0**（热区贴边）⇒ "看得见的块"离画布边
        (56−40)/2 ＝ **8**，与左下那条的 `bottom / left 0` 完全同值
        ⇒ 四个角的**可见间距**都是 8，两条对角呼应的工具条几何上互为镜像。
        ⚠️ 253/254 那版是"上 10 / 右 12"，块离边其实 19 / 21（差 2px 且两侧都偏松）；
          这类偏移在四个角上会被成对放大，用户这次就是把它读出来了。
        ⇒ 安全带 `SAFE_T` 随之 84 → **64**（0 ＋ 56 ＋ 8），`check_safe_band.js` 逐值对撞。
        ⚠️ 宽度账（255 轮重算）：5×56 ＋ 2×(1＋5) ＋ 6×5 ＝ **322**，
          横屏内宽 1168 / 竖屏内宽 768 仍富余（254 那版 380、253 那版 254）。
     ⑤ ★★★ **256 轮：四边可见距离 8 → 12** —— 用户口径「四边的边距从 8 改为 12，
        目前又有点太小了」。
        `top / right` 从 `0 / 0` 收到 **4 / 4**（热区贴边 4 ⇒ 可见块离边
        4 ＋ (56−40)/2 ＝ **12**），左下那条的 `bottom / left` 同步 4，
        左上比例胶囊 `8 → 12` ⇒ **四边一律 12**。
        ⚠️ 这几个数只跟着"可见块离边"走，别按"热区离边"去读：热区 4 是**中间量**，
           看得见的那 40 方块才是用户量的东西（255 轮就是在这条上算反过一次）。
        ⇒ 安全带 `SAFE_T` 64 → **68**（4 ＋ 56 ＋ 8）。
        ⚠️ 条宽 322 不变（键的尺寸、间距、竖线一个字没动，这一轮只挪整条的位置）。

   ⚠️ 第 81 轮：5 键 ＋ 2 道竖线（用户第 2 条把「格式」撤掉、第 1 条把「展开 / 收起」搬上来）。
      顺带删掉 `.mt-sep.far`（那是给"不归任何一组的 ⋯"留的宽间距，第 71 轮就没第三组了）。
   ⚠️ 外层通栏仍 `pointer-events: none`、内层才 `auto`：否则贴右之后，右边那半张画布
      仍会被外层那圈透明盒子吞掉手势（看不到的东西吃事件，是最难查的一类）。
   ⚠️ 尺寸与左下那条**必须成对**（见 `.mm-float-wrap` 那段）：h 56 / gap 5 / sep 21 / 热区贴 0，
      两处只要改单边，两条工具条就会一胖一瘦 —— `工具/check_safe_band.js` 会把这事抓红。 */
.mm-top {
  position: absolute;
  left: auto;
  right: 4px;
  top: 4px;
  /* ★ 254 轮：与 `.mm-float-wrap` 对齐的**限宽**。贴右 + `left:auto` ⇒ 宽度是收缩适应，
     而窄屏（手机档设计稿 400 / 画布内宽 368）上 380 的键排会被算成 max-content ⇒
     整条从右边往左**溢出画布**（最左那两颗被 `.mm-card` 的 overflow 裁掉，不报错）。
     限宽之后，多出来的宽度由内部键的 `flex-shrink` 吃掉（只压热区）。
     ★ 255 轮：热区贴 0 ⇒ 限宽就是 `100%`。
     ★ 256 轮：热区贴边 4 ⇒ 限宽改成 `calc(100% - 8px)`（左右各让 4）——
     否则满宽那档会从右边 4 往左长出 4px，左端落到画布外（被静默裁掉）。 */
  max-width: calc(100% - 8px);
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  pointer-events: none;
  z-index: 7;
}

/* 内层实体：**不再有底/边/影**，只是一排键（253 轮） */
.mm-tools {
  height: 56px;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 5px;
  pointer-events: auto;
}

/* 两组之间那道竖线（★ 第 81 轮起有两道 —— 三组键）
   ★ 253 轮 24 → **17**；★ 254 轮 17 → **26**；★ 255 轮 26 → **21**
   （与 `.fb-sep` 同值同来路，两处必须同步）。 */
.mt-sep {
  width: 1px;
  height: 21px;
  background: var(--hairline);
  flex: 0 0 auto;
  margin: 0 3px;
}

/* ==========================================================================
   ★★★ 第 303 轮 · **画布左上角那个竖列**（PC 操作提示 ＋ 瞬时缩放比例）
   ── 一个盒子解决"谁在谁下面" ──────────────────────────────────────────
   两件东西本来就抢同一个角落（都是 left 12 / top 12）：提示一加进来就会盖住比例尺，
   而提示的高度随字号/折行变化 ⇒ 用绝对定位写"比例尺在提示下方"只能靠魔法数字。
   ⇒ 外层这一层定在**原来那个 12 / 12**（位置一个字没变），两件都变成 flex 子项、`gap: 8`：
     · 提示在 ⇒ 比例尺自然落到它下面；
     · 提示关掉 ⇒ 比例尺自动回到 12 / 12（与 255/256 两轮验收过的位置逐像素一致）。
   ⚠️ 外层 `pointer-events: none`、内层各自 `auto` —— 这层盒子比看得见的东西大，
      整片 `auto` 会把画布左上角的手势悄悄吞掉（253 轮那条教训，别再来一次）。
   ⚠️ 窄屏那一档（`max-width: 400px`）从"挪 `.mm-zoom`"改成"挪这一层"，
      理由见那条媒体查询上方的注释。
   ========================================================================== */
.mm-tl {
  position: absolute;
  left: 12px;
  top: 12px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  pointer-events: none;
  z-index: 6;
}

/* ==========================================================================
   ★★★ 第 303 轮 · **PC 端操作提示**（用户第 4 条 · 样式参照 `.cp-hint`）
   ── 与手机端那条新用户提示同源的三件事 ────────────────────────────────
     · 底色 `--yellow-soft` ＋ 描边 `--yellow-line` ＋ 字色 `--u-mid-t`（琥珀）：
       这是"指个路"的色，不是"出错了"的色 —— `--danger` 在这套色系里只属于破坏性动作；
     · 圆角 10、内距 `8 / 10`、字号 12、右边一颗 22 见方的 ✕；
     · 深色模式下这三支令牌都有深色档（app.wxss 里成对定义）⇒ 这里**一个硬色值都没有**。
   ── 为什么是固定 180 宽而不是 `max-content` ──────────────────────────
    三行的"标签 + 说明"长度不等（"节点即可编辑文字"比"新增同级节点"长），
    `max-content` 会让这张卡随内容胖瘦，而它就贴在画布左上角 —— 一块会变宽的小卡片
    比一块定宽的小卡片更容易撞到右边的键排。180 ＝ 文案最长那一行（8 个全角字 ≈ 96）
    ＋ 键帽 44 ＋ 间距 8 ＋ 左右内距 20，留 12 余量。
   ⚠️ 面板里**没有原生控件**，所以不怕祖先 `transform: scale(s)`（那是 textarea 的坑）。
   ========================================================================== */
.mm-tip {
  width: 180px;
  box-sizing: border-box;
  padding: 8px 10px;
  border-radius: 10px;
  background: var(--yellow-soft);
  border: 1px solid var(--yellow-line);
  color: var(--u-mid-t);
  font-size: 12px;
  pointer-events: auto;
}
/* 头一行：图标 ＋ 标题 ＋ 关闭键。标题 `flex:1` 吸收余量，把 ✕ 顶到最右。 */
.mm-tip-h {
  display: flex;
  align-items: center;
  gap: 7px;
}
.mm-tip-h-t {
  flex: 1 1 auto;
  min-width: 0;
  font-weight: 600;
  line-height: 1.5;
}
/* 关闭键 22 见方 —— 与 `.cp-hint-x` 逐值同源（那颗也是 22，理由：条子的 `padding`
   已经兜住了可点范围，不必再套一层伪元素热区）。 */
.mm-tip-x {
  flex: 0 0 auto;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mm-tip-x-hv { background: var(--yellow-line); }
/* 一行一条捷径：键帽（定宽，等宽对齐）＋ 说明（吸收余量、可折行）。 */
.mm-tip-r {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 6px;
}
/* 键帽 —— 白底（`--card`）＋ 暖描边，读作"这是一颗键"。
   ⚠️ 定宽 44 是为了三行**左边缘对齐**：不定宽时 "Tab" 与 "双击" 长短不一会让
      说明文字每行起头都不在一列上（这类不齐，横着看过去一眼就能看出来）。 */
.mm-kbd {
  flex: 0 0 auto;
  width: 44px;
  box-sizing: border-box;
  padding: 0 4px;
  border-radius: 6px;
  background: var(--card);
  border: 1px solid var(--yellow-line);
  font-size: 11px;
  font-weight: 600;
  line-height: 16px;
  text-align: center;
  /* 数字/英文（Tab / Enter）走等宽数字族？不必 —— 这里没有数字，用默认字体即可 */
}
.mm-tip-t {
  flex: 1 1 auto;
  min-width: 0;
  line-height: 1.5;
}
/* 脚注：那句"需先点选节点"是 Tab / Enter 能不能用的前提，退一档亮度当注解读。
   ⚠️ 用 `opacity` 而不是另调一支灰：它在黄底上，灰字（`--muted`）对比度不够。 */
.mm-tip-f {
  display: block;
  margin-top: 6px;
  font-size: 11px;
  line-height: 1.5;
  opacity: 0.8;
}

/* ---------------- 瞬时缩放比例 · **容器内左上角**（★ 本轮第 4 条 · ★★ 第 253 轮换到左上） ----------------
   只在缩放进行中可见：JS 每次缩放点亮（`.on`），停手 900ms 后自己收掉。
   默认 opacity 0 且不吃事件 —— 平时它就是一块透明，不会挡住画布上的节点。
   ★★ 253 轮：落点从左下 → **左上**（左 12 / 上 14），为什么是这两个数：
     · 左下那格让给了**节点操作条**（"右上管脑图、左下改节点"的对角布局）；
     · `top:14 + height:36` ⇒ 垂直中心落在 **32**，与右上那排键（`top:10 + 44/2`）**同一条水平线**。
       差 4px 横着看过去就是"两个角各飘一块"，这类不齐是最容易被一眼看出来的。
   ★★★ 254 轮：右上那排键长到 66 ⇒ 中心从 32 升到 **43**（10 ＋ 66/2），
      本条 `top` 随之 14 → **25**（25 ＋ 36/2 ＝ 43），仍然是"两个角同一条水平线"。
   ★★★ 255 轮第 3 条（用户逐字：「左上角的动态比例尺尺寸应该参考按键的大小，字号应该参照
        子标题字号，距离左侧和上侧画布间距应该和上下按键区一样」）⇒ 三个维度一起对齐：
     · **尺寸**：高 36 → **40 ＝ 视觉块的大小**（不是热区 56）。用户看屏幕时看到的是有底色的
       那 40 方块，"按键大小"指的就是它。⚠️ 别按热区 56 去放大：那会让左上变成一块
       比每颗键都大一圈的空盒子，而它只是个读数。
     · **字号**：13 → **16px / 600** ＝ 区块子标题 `.sec-t` 那一档（`app.wxss` 的"区块头"规则，
       全工程五页共用）。⚠️ 别照脑图头部 `.mh-name` 的 13 来对 —— 那是"图名"不是"子标题"。
     · **贴边**：`left / top` 都是 **8**，与按键**可见块**到画布边的距离一模一样
       （热区贴 0 ＋ 块居中内缩 (56−40)/2 ＝ 8）⇒ 左上这块与右上那排键**同高、同顶边、同左距**，
       横着看过去是一条线上的一组控件。圆角 10 → **12**（跟 40 高对得上，与视觉块同值）。
   ★★★ 256 轮第 5 条（用户口径「四边的边距从 8 改为 12」）：
     · **贴边 8 → 12**（`left / top` 一起），与按键的可见块、编辑白卡三处同值
       （按键那边是 4 ＋ (56−40)/2 ＝ 12，白卡是 4 ＋ margin 8 ＝ 12）。
       ⚠️ 别再让这三个数各算各的：它们量的是同一件事 —— "看得见的东西离画布边多远"。
   ⚠️ 254 那版"top 25 为对齐中心线手调"的做法随之作废：现在顶边对齐（都是 12）、高度相同（40），
      中心自然就同高，不需要中间值 —— 那种手调的数最容易被下一轮"统一"时改坏。
   ⚠️ 宽度仍随文字（`100%` 约 4 字符 ≈ 38 ＋ 左右 padding 24 ＝ 62），不写死：
      将来出现 `125%` / `1000%` 也撑得开。
   ⚠️ 它仍是四件浮层里**唯一平时不存在**的一件 ⇒ 放哪个角都不会长期占地方。
   ⚠️ 当年那条"`bottom` 要跟着浮条圆心走"的口径随落点一起作废（浮条已不在这一侧），
      别再照着老注释把它挪回左下。
   ★★★ 303 轮：**`position/left/top/z-index` 三行撤掉** —— 它现在是 `.mm-tl` 的第二个
      flex 子项（提示在它上面）。位置仍是 12 / 12（父盒子的 `left/top`），高度 / 字号 /
      显隐 / 点击行为一个值都没改；`flex: 0 0 auto` 是必需的一句 —— 这一列是竖向
      `column`，不写它的话 `height: 40` 会被 `align-items: flex-start` 之外的拉伸规则
      （`stretch`）改判成"撑满整列"（`.mm-tl` 是 `align-items: flex-start`，横向不拉伸，
      但纵向的 `flex-shrink:1` 在窄高容器里仍会把它压扁 ⇒ 显式钉住）。 */
.mm-zoom {
  flex: 0 0 auto;
  height: 40px;
  padding: 0 12px;
  border-radius: 12px;
  background: var(--card);
  border: 1px solid var(--hairline);
  box-shadow: var(--sh-float);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-num);
  font-size: 16px;
  font-weight: 600;
  color: var(--primary);
  opacity: 0;
  pointer-events: none;
  transition: opacity 180ms ease;
}
.mm-zoom.on { opacity: 1; pointer-events: auto; }

/* ★★★ 255 轮 · **窄屏让位**（手机档）：本条与右上键排在窄画布上会**区间重叠**。
   算给你看：键排 322（热区贴边 4、右对齐）⇒ 左端在 `画布宽 − 4 − 322`；本条占 `12 – 74`。
   两者不碰的条件是 `画布宽 − 326 > 74` ⇒ 画布宽 > **400**。
   手机档画布只有 352（屏宽 390 上下减页边距 32）⇒ 必然重叠，而键排 z-index 7 压在本条 5 之上
   ⇒ 缩放那 900ms 里，比例读数会被第一颗「撤回」切掉一半（253/254 两轮一直如此，255 轮才量清）。
   ⇒ 这一档把本条挪到键排**下方**。
   ⚠️ 用 `max-width` 而不是 JS 判形态：判据/页面都不必再接一个 `phone` 字段，
      而且它要挡的条件本来就是"画布多宽"这件事本身。
   ⚠️ 临界值是 **400**（256 轮重算：`W − 326 > 74` ⇒ `W > 400`；255 那版热区贴 0，算出来是 392）。
      取 `max-width: 400px` 而不是 392：正好把"贴着临界"那一档也纳入让位，
      避免模擬器与真机的页边距差 1–2px 时两个盒子擦边（卡死在临界上最难查）。
      左端实测：手机档 `352 − 326 = 26` ＜ 74 ⇒ 确实重叠，让位是必要的。
      平板竖屏 768、横屏 1168 都远在这条线以上。
   ★ 256 轮：`top 64 → 68` ＝ 热区贴边 4 ＋ 条高 56 ＋ 8 的呼吸
      （原来是 0 ＋ 56 ＋ 8；热区整体下移 4，这一档必须跟着走，否则会压住键排下沿）。
   ★★★ 303 轮：**让位对象从 `.mm-zoom` 换成 `.mm-tl`** —— 比例尺已经不住在"绝对定位"
      这一层了（它是 `.mm-tl` 的子项），继续写 `.mm-zoom { top }` 会变成一句**静默无效**
      的样式（`static` 元素不吃 `top`，不报错、画面上也没变化）。闸门从"挪本件"上抬到
      "挪整列"，效果与 256 轮验收过的位置逐像素一致（手机档整列仍从 y68 起）。 */
@media (max-width: 400px) {
  .mm-tl { top: 68px; }
}
/* ★ 审查-02 S1（2026-10-15）：按下反馈。
   ⚠️ 它平时 `pointer-events: none`（只有 `.on` 可见期间才吃事件）⇒ 本条也只在那期间起作用。
   白底描边胶囊 ⇒ 与 `.tb-btn-hv` 同族（改底 `--chip`）。
   ⚠️ `.mm-zoom.on`（0,2,0）只改 `opacity`/`pointer-events`、**不碰 `background`** ⇒ 与本条不冲突。 */
.mm-zoom-hv { background: var(--chip, #F1F2F5); }
/* ★ 审查-02 P1-7（2026-10-14）：`.on` 之外**保持 `pointer-events: none`** ——
   它是一块常驻盒子（现在是 40 高、宽随文字 ≈ 62），若一直可点，画布**左上角**那片手势会被它悄悄吞掉。
   ★ 255 轮：按下列三档重算过"会不会撞上右上那排键"；
   ★ 256 轮（贴边 8 → 12）重算一遍：本条占 x **12 – 74**，右上条左端在 `W − 326`：
     · 横屏 1168：左端 ≈ **842**，本条 12–74 ⇒ 相去甚远。
     · 竖屏 768：左端 ≈ **442**，同样够不着。
     · 手机档 352：左端 ≈ **26**（块的左沿 34）⇒ 与本条（12–74）**区间重叠**，
       但那一档由上面 `@media (max-width: 400px)` 把本条下移到 y68 解决 ⇒ 现在**不再打架**。
   ⚠️ 它平时 `opacity: 0` 且不吃事件，只有缩放中 900ms 内露脸；`z-index: 5 < 7` ⇒ 键排压在上面，
      即便将来又有一档重叠，那 900ms 里点键也照常生效，只是比例读数被挡住一角。
   ⚠️ 若将来真要再让位，改的是"`.mm-zoom` 的位置"，**别动 `pointer-events`**。
   ⇒ 可见期间点它 ＝ `fitView()`（触屏的「适应屏幕」入口；PC 的键盘 `0` 一字未改）。 */

/* ★ 本轮删除：原「卡内底部行 · 左」那一整组缩放控件 ——
   `.mm-bottom` / `.mb-zoom` / `.zbtn` / `.zval` / `.z-sep` / `.zfit` 六条。
   用户口径：左下角那个屏幕比例尺显示控制取消，只留"缩放时浮现"的比例（＝上面那条 .mm-zoom）。
   这些类名在 wxml 里已无引用；留在此处一条注释，是为了让后来的人知道
   "这里曾经有一排控件、被有意删掉了"，而不是以为漏抄。 */

/* ==========================================================================
   竖屏（画布 727403959376047）
   ★ 本轮：**卡下方那行脑图级操作行整条取消** ⇒
     1128 − 上 12 − 下 16 ＝ 1100 ＝ 区块头 42 ＋ 画布卡 **1058**
     （原式：区块头 42 ＋ 画布 1006 ＋ 12 ＋ 操作行 40）
   ★ 09-23 走查·十七：1128 / 1058 都改成由 --work-h-port 推出来的量 —— 真机状态栏比
     设计稿的 24 高，工作区会让出 (状态栏 − 24)（MatePad Mini 上 1128 → 1091），
     画布跟着矮同样多（1058 → 1021）。两个数写死会在真机上顶穿底栏。
   （第四轮把节点操作行搬进容器 ⇒ 画布 996 → 1048；09-22 走查·上补区块头 ⇒ 1048 → 1014；
     09-22 走查·下首块间距 16 → 20 ⇒ 1014 → 1010；
     09-22 走查·十品牌栏 36 → 40 ⇒ 1010 → 1006）
   节点三档字号 15 / 14 / 11；卡内工具栏与浮条都**只贴角、不再通栏**（★ 253 轮）：
     · 脑图级  → 右上角，热区带 y4–**60**（top 4 ／ h 56），可见块在 y12–52、x 贴右 12；
     · 节点级  → 左下角，热区带 y(画布高−**60**)–画布高（bottom 4 ／ h 56），可见块同理；
     · 缩放比例 → 左上角，只在缩放时浮现（贴 12 ／ 高 40 ⇒ 与按键的可见块同高、同顶边）。
   （81 轮那版是上下两条通栏胶囊、各占 76 高；253 轮减重后条高 60 → 44、贴边 16 → 10
     ⇒ 安全带 84 → **62**；254 轮键整体 ×1.5 ⇒ 条高 44 → **66**、安全带回到 **84**；
     255 轮收到 ×1.25、热区贴 0（可见块离边 8）⇒ 条高 **56**、安全带 **64**；
     ★ 256 轮四边可见距离 8 → **12**（热区贴 4）⇒ 安全带 **68**，条高仍 56。
     见 `mindmap-core.js` 的 `BAR_H` / `BAR_GAP` / `BAR_BREATH`。）
   ⚠️ 竖屏不再单独放「导出 md 映射规则」浮块 —— 节点是自动排版、会铺满画布，
      浮块必然压住节点；同样的规则文案由容器下方的脑图级操作行承载。
   ========================================================================== */
.mod-port .mm-area {
  /* ★★ 204 轮：本页**不滚**（画布吃满整格、内部自己 pan）⇒ 让位段在这页等于
     "固定的一段"（用户口径：「脑图页本身就是单屏占满的显示，所以 logo 也应该进行固定，
     但是是不是应该同样的一起去掉这个 .titlebar？然后在内容区把占位 logo 这块的高度加回来？
     这样是不是就可以保证和其他页面统一了？」—— 正是这一条）。
     结构仍与其他四页**完全一致**（一样撤 `.titlebar`、一样把 `<brand-head>` 放第一位），
     只是这一页的容器不滚，所以段不会走。
     ⚠️ 高度也必须吃满（`--scroll-h-port`），否则画布会被挤出容器；
        而画布自身仍是 `calc(var(--work-h-port) - 70px)` —— **一个字没改**，
        多出来的 headH 正好被让位段用掉 ⇒ 画布尺寸与 204 之前相同。 */
  flex: 0 0 var(--scroll-h-port);
  height: var(--scroll-h-port);
  padding: 0 16px 16px;
  gap: 12px;
  /* ★★ 206 轮：**这一页故意不跟着缩**。概览／项目／我的把 `--head-extra` 从 12 收到 4，
     是为了让"logo → 首个子标题"更紧；而脑图页首块就是画布、**没有子标题**，
     缩了只会让画布底下多出一条等宽空白（画布高是 `work-h-port − 70` 推出来的，不随让位变）。
     ⇒ 保持 204/205 的老口径 12。 */
  --head-extra: var(--gap-base);
  --area-gap: 12px;
}
/* ★ 09-23 走查·十七（★ 本轮改数）：画布高不再写死 —— 它是「工作区 − 70」推出来的，
   而工作区随真机状态栏变（fit() 写 --work-h-port，MatePad Mini 上 1128 → 1091）。
   70 ＝ 上 12 ＋ 下 16 ＋ 区块头 42。（原来是 122 ＝ 上面三项 ＋ gap 12 ＋ 脑图级操作行 40；
   本轮那行整条取消 ⇒ 122 → 70，画布 1006 → 1058。）
   ⚠️ 同一根链条上的 mod-mindmap.js 的 CANVAS.port.h 必须同步（那边调 stage.portWorkH()）。 */
.mod-port .mm-viewport { width: 768px; height: calc(var(--work-h-port) - 70px); }
.mod-port .links,
.mod-port .mm-links-hl { width: 768px; height: calc(var(--work-h-port) - 70px); }

/* ⚠️ 第 66 轮：竖屏**不再**单独改一套字号。
   字号不只是"显示多大"——它还决定了节点的估宽（JS 的 MM_FS 是一套、不分方向）。
   这里若再覆盖一层，估出来的宽就与实际渲染的文字对不上（文字贴边或空一截）。
   竖屏节点本来就比横屏高一档（见 JS 的 SZ.port.h），17 / 15 / 14 放进去比例够。 */

/* ★ 第 67 轮：竖屏内边距比横屏紧 1px —— 与 JS 的 NODE_PAD.port.x（12）配成一对，
   两边差 2px 就是留给"估宽比实际窄一点"的余量。 */
.mod-port .mm-node { padding: 0 10px; }

/* ⚠️ 第 112 轮**删除**：原来这里有竖屏那一对
   `.mod-port .mm-node.edit { padding: 0 }` / `.mm-node-in { padding: 9px 0 }` /
   `.mm-node-li { padding: 0 10px }`。
   它们存在的唯一理由是"横屏那条 `.mm-node.edit`（0,2,0）会被上面的
   `.mod-port .mm-node`（0,2,0）静默赢掉" —— 那是**卡内输入框**时代的特异性问题。
   编辑区搬去卡片外之后，卡片上不再有输入控件、`.mm-node.edit` 也只剩一条动画
   （动画不参与"padding 谁赢"这件事）⇒ 这三条连同它们要解决的矛盾一起消失。
   ⚠️ 别因为"竖屏好像哪里差 1px"就把它们加回来：先去看 `.mm-node.edit` 现在
      到底还剩几条声明（应当只有 `animation` 与 `z-index`）。 */

/* ★ 第 70 轮：**竖屏也要留竖线**。
   五颗键分三组，"三组"这件事本身就只靠那两道竖线读出来 —— 66 轮在竖屏藏掉竖线，
   是因为那时浮条只有一组键、竖线纯属多余；现在藏着等于"三组糊成一排五颗"。
   宽度账（★ 253 轮重算）：5×44 ＋ 2×(1＋4) ＋ 6×4 ＝ **254** ＜ 768 内宽
   （81 轮那版是 322；253 轮"外壳减重"把组间距 12→4、内边距 10→0，整条更窄了）。

   ⚠️ 第 71 轮**删掉** `.mod-port .mm-float { padding: 0 6px }` 这条竖屏覆盖 ——
      它当初的理由是"竖屏窄、要给标签腾地方"，而标签已经整块取消（见上方 `.nr-tag` 那段），
      腾出来的宽度富余得很 ⇒ 这条覆盖失去意义。
      ⇒ 现在**竖屏对浮条一条覆盖都没有**，横竖两个方向完全同款（同样的间距、同样的 254 宽），
        正好落在用户这句口径上：「横版竖版要一致」。
