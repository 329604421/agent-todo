        <view class="sec sec-info">
          <view class="sec-head">
            <icon name="info-b" size="16" />
            <text class="sec-t">待办信息</text>
          </view>

          <view class="card hero-card">
            <view class="hero-top">
              <view class="hero-flag" style="background:{{detail.urgency.main}}"></view>
              <text class="hero-urg" style="color:{{detail.urgency.text}}">{{detail.urgency.name}}</text>
