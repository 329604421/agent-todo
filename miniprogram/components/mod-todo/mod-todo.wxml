                  <view wx:for="{{detail.mindmap.view.nodes}}" wx:key="id"
                        class="mm-node {{item.cls}}" style="{{item.style}}">
                    <text wx:for="{{item.lines}}" wx:for-item="ln" wx:for-index="li"
                          wx:key="i" class="mm-node-t">{{ln.t}}</text>
                    <!-- ★★ 275 轮：节点挂图 —— 与画布**同一份皮肤**（mm-canvas.wxss 里那条
