          自动不渲染，否则会在空详情上留一张孤零零的模态框。 -->
  <view class="viewer" wx:if="{{capOpen && detail.capsules[capIndex]}}">
    <view class="viewer-mask" bindtap="onCapClose"></view>
    <view class="viewer-box">
      <view class="viewer-top">
        <text class="viewer-t">闪念胶囊 {{capIndex + 1}} / {{detail.capCount}}</text>
        <view class="viewer-x" bindtap="onCapClose" hover-class="viewer-x-hv">✕</view>
      </view>
      <view class="cap-view">
        <text class="cap-view-t" selectable>{{detail.capsules[capIndex].text}}</text>
        <!-- ★★ 263 轮（清单 C4/H4）· **这条胶囊挂的图** —— 点它看大图。
             ★★ 277 轮：网格卡里**也已经画了图**（`.cap-pic`，88 高的一条），
                但这一层仍然要留一张原尺寸的：
                  · 格子那张是"有没有图"的提示（198×88，够认出是什么，读不清字）；
                  · 这一层是"看"，图按卡宽原样铺（`.cap-view-img`），且能点开 `wx.previewImage`。
                两处**不是重复**：一处在网格里占位、一处在全文里给全貌。
             ⚠️ 这里用 `catchtap`：外层 `.cap-view` 没有 tap，但遮罩层有
                （`viewer-mask` 是"点外面关掉"）—— 不 `catch` 的话点图等于关弹窗，
                图永远看不到。`urls` 只放这一张（理由见 capsule.js 的 `onPreviewImg`）。 -->
        <!-- ⚠️ `hover-class` 的宿主只认 `view` / `button` / `navigator`
             （挂在 `<image>` 上**既不报错也不生效**，等于没改）⇒ 外面套一层 `view`
             来挂按下态 ＋ 接 `catchtap`，`<image>` 只负责显示。 -->
        <view
          wx:if="{{detail.capsules[capIndex].img}}"
          class="cap-view-pic"
          data-src="{{detail.capsules[capIndex].img}}"
          catchtap="onCapViewImg"
          hover-class="cap-view-pic-hv"
        >
          <image
            class="cap-view-img"
            src="{{detail.capsules[capIndex].img}}"
            mode="widthFix"
            lazy-load
          ></image>
        </view>
      </view>
      <view class="cap-view-foot">
        <text class="cap-view-time">{{detail.capsules[capIndex].time}}</text>
      </view>
    </view>
  </view>

  <!-- 列表类主弹窗（★ 47 轮：id 是给核验脚本 selectComponent 用的 —— 组件内绝对层
       没法用页面选择器拿到；同时也是「待办筛选」副弹窗的父层） -->
  <!-- ★★ 249 轮：这张抽屉的每一颗键都由**属性**决定，页面不绑 ⇒ 组件静默取默认值（空串），
       那一颗键就整颗不渲染。本轮踩的就是这个：`drawers.build('capsule')` 早就给了
       `confirmLabel: '保存'`，而这里漏绑了 `confirm-label` ⇒ 底部只剩「取消」。
       ⚠️ 以后往 `drawers.build()` 里加任何"决定渲染"的字段，**同一次改动里必须回来补绑定**：
          少绑不会报错、不会报警、判据也照样绿 —— 只有真机点开才看得见。
       ⚠️ 注释只能写在这张标签**外面**：塞进属性列表中间会让整页白屏（217 轮实锤）。 -->
  <drawer
    id="todo-list"
    open="{{drawer.open}}"
    kind="{{drawer.kind}}"
    title="{{drawer.title}}"
    action="{{drawer.action}}"
    create-label="{{drawer.createLabel}}"
    filter-label="{{drawer.filterLabel}}"
    filter-active="{{drawer.filterActive}}"
    filter-open="{{drawerFilterOpen}}"
    tf="{{drawer.tf}}"
    active-id="{{drawer.activeId}}"
    empty="{{drawer.empty}}"
    groups="{{drawer.groups}}"
    page-size="{{drawer.pageSize}}"
    port="{{!landscape}}"
    turned="{{drawerTurned}}"
    multi="{{drawer.multi}}"
    pick-map="{{drawer.pickMap}}"
    confirm-label="{{drawer.confirmLabel}}"
    picked-id="{{drawer.pickedId}}"
    cancel-label="{{drawer.cancelLabel}}"
    bind:close="onDrawerClose"
    bind:pick="onDrawerPick"
    bind:markmulti="onCapMark"
    bind:cancel="onCapCancel"
    bind:confirm="onCapConfirm"
    bind:create="onDrawerCreate"
    bind:openfilter="onDrawerOpenFilter"
    bind:closefilter="onDrawerCloseFilter"
    bind:filterchange="onDrawerFilterChange"
    bind:filterreset="onDrawerFilterReset"
  />

  <!-- 一级表单抽屉：记一条待办 / 编辑待办 / 导出 agent 文本（mode=export） -->
  <form-drawer
    id="todo-form"
    open="{{form.open}}"
    mode="{{form.mode}}"
    offset="{{form.offset}}"
    edit-id="{{form.id}}"
    title="{{form.title}}"
    submit-label="{{form.submitLabel}}"
    require-all="{{form.requireAll}}"
    no-danger="{{form.noDanger}}"
    hint="{{form.hint}}"
    values="{{form.values}}"
    urgencies="{{form.urgencies}}"
    projects="{{form.projects}}"
    mindmaps="{{form.mindmaps}}"
    nodes="{{form.nodes}}"
    agents="{{form.agents}}"
    colors="{{form.colors}}"
    formats="{{form.formats}}"
    port="{{!landscape}}"
    turned="{{formTurned}}"
    child="{{form.child}}"
    enh-text="{{enhView.text}}"
    enh-state="{{enhView.state}}"
    enh-error="{{enhView.error}}"
    enh-notice="{{enhView.notice}}"
    bind:cancel="onFormCancel"
    bind:submit="onFormSubmit"
    bind:newproject="onFormNewProject"
    bind:newmindmap="onFormNewMindmap"
    bind:enhance="onFormEnhance"
  />

  <!-- ⑫ 二级表单抽屉（★ 45 轮）：待办表单里点「＋ 新建项目」时，项目新建表单落在**右侧**，
         本层（待办表单）侧转且不可点 —— 与「项目列表抽屉 → 新建项目」是同一套观感。
         两个抽屉宽度都是 320，右移 270 后一级的左缘旋转 25° 正好让出 12px 缝。
         ★ 278 轮起它还有一个用途：「信息增强」也落在这一层（`mode='enhance'`），
           左侧导出抽屉侧转不可点 —— 与「新建项目」共用同一套几何，一个新 px 都不用写。 -->
  <form-drawer
    id="todo-form-l2"
    open="{{form2.open}}"
    mode="{{form2.mode}}"
    offset="{{form2.offset}}"
    edit-id="{{form2.id}}"
    title="{{form2.title}}"
    submit-label="{{form2.submitLabel}}"
    require-all="{{form2.requireAll}}"
    no-danger="{{form2.noDanger}}"
    hint="{{form2.hint}}"
    values="{{form2.values}}"
    urgencies="{{form2.urgencies}}"
    projects="{{form2.projects}}"
    mindmaps="{{form2.mindmaps}}"
    nodes="{{form2.nodes}}"
    agents="{{form2.agents}}"
    colors="{{form2.colors}}"
    port="{{!landscape}}"
    child="{{form2.child}}"
    enh-text="{{enhView.text}}"
    enh-state="{{enhView.state}}"
    enh-error="{{enhView.error}}"
    enh-notice="{{enhView.notice}}"
    bind:cancel="onFormCancel"
    bind:submit="onFormSubmit"
    bind:newproject="onFormNewProject"
    bind:newmindmap="onFormNewMindmap"
    bind:enhance="onFormEnhance"
  />
<!-- /mod-todo -->
