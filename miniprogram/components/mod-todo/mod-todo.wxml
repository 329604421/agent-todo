                bindtap="onCapOpen"
                hover-class="cap-hv"
              >
                <text class="cap-t">{{item.text || '（这条还是空的）'}}</text>
                <!-- ★★ 277 轮（用户口径 2026-10-27 第 3 条）：「待办详情中的胶囊卡片中
