  margin-left: 2px;
  margin-top: 8px;
}

.ag-ring-lab {
  font-size: 11px;
  color: var(--muted);
  white-space: nowrap;
}

.ag-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.ag-mcell {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.ag-mdiv {
  height: 1px;
  background: var(--hairline-soft);
}

.ag-lab {
  font-size: 12px;
  color: var(--muted);
  white-space: nowrap;
}

.ag-val {
