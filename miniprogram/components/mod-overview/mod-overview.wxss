  font-weight: 600;
  color: var(--primary);
  line-height: 1;
}
.ag-ring-num.muted {
  font-size: 13px;
  font-weight: 500;
  color: var(--muted);
}

.ag-ring-unit {
  font-size: 11px;
  color: var(--muted);
